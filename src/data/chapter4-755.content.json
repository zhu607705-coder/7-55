  "dialogues": {
    "opening.paper_flight": [
      {
        "speaker": "system",
        "text": "现场画面已同步。异常签到纸正在飞向公告栏。"
      }
    ],
    "opening.paper_caught": [
      {
        "speaker": "player",
        "text": "抓到了。"
      },
      {
        "speaker": "system",
        "text": "正在提交签到记录……"
      }
    ],
    "opening.external_time_rejected": [
      {
        "speaker": "system",
        "text": "提交失败。外部时间：22:45。"
      },
      {
        "speaker": "system",
        "text": "签到截止时间：07:55。"
      },
      {
        "speaker": "player",
        "text": "手机上还写着 07:55:23。"
      },
      {
        "speaker": "system",
        "text": "它已经被四个外部来源否定了。"
      },
      {
        "speaker": "system",
        "text": "记录回来了，你没有回到记录发生的时候。"
      }
    ],
    "hall_clock.first_inspection": [
      {
        "speaker": "system",
        "text": "旧钟能被拨动，但指针不会按你的动作走。"
      },
      {
        "speaker": "player",
        "text": "这是好消息？"
      },
      {
        "speaker": "system",
        "text": "它还在出错。"
      }
    ],
    "hall_clock.first_pull": [
      {
        "speaker": "system",
        "text": "时间源已切换：大厅旧钟。"
      }
    ],
    "bakery.hour_hand_collected": [
      {
        "speaker": "baker",
        "text": "你拿走那个？我还以为它是新品配料。"
      },
      {
        "speaker": "player",
        "text": "它本来是时针。"
      },
      {
        "speaker": "baker",
        "text": "那它总算找到对口味了。"
      }
    ],
    "room204.restored": [
      {
        "speaker": "projection",
        "text": "07:55 / 早到的人还没有开始后悔。"
      }
    ],
    "maintenance.cleaner": [
      {
        "speaker": "cleaner",
        "text": "它没坏，只是不肯走。"
      },
      {
        "speaker": "player",
        "text": "我有办法让它走。"
      },
      {
        "speaker": "cleaner",
        "text": "那你先让它别叫。"
      }
    ],
    "blackout.minute_stolen": [
      {
        "speaker": "system",
        "text": "时间校准至 07:54。"
      },
      {
        "speaker": "player",
        "text": "差一分钟。"
      },
      {
        "speaker": "system",
        "text": "纸条把最后一分钟带走了。定位结果：阶梯教室。"
      }
    ],
    "chase.started": [
      {
        "speaker": "guard",
        "text": "同学，站住。"
      },
      {
        "speaker": "system",
        "text": "清楼流程启动。"
      }
    ],
    "chase.failed": [
      {
        "speaker": "guard",
        "text": "出去。"
      },
      {
        "speaker": "system",
        "text": "你被清楼流程退回了上一分钟。"
      }
    ],
    "chase.arrived": [
      {
        "speaker": "system",
        "text": "阶梯教室门已关闭。"
      }
    ],
    "lecture.final_minute_recovered": [
      {
        "speaker": "player",
        "text": "不跑了？"
