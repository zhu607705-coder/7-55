{
  "name": "seven-fifty-five",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-node-tests.mjs",
    "test:unit": "node scripts/run-node-tests.mjs",
    "test:project-preview:visual": "node scripts/project-preview-visual-smoke.mjs",
    "build:single": "npm run build:demo",
    "verify:single": "node scripts/verify-single-file-build.mjs",
    "build:campus-map-demo": "tsc --noEmit && vite build --mode campus-demo",
    "verify:campus-map-demo": "node scripts/verify-single-file-build.mjs campus-map-demo.html",
    "build:project-preview": "tsc --noEmit && vite build --mode project-preview",
    "verify:project-preview": "node scripts/verify-single-file-build.mjs project-preview.html",
    "verify:structure": "node scripts/verify-repository-structure.mjs",
    "verify:pr": "npm run verify:structure && npm run map:zijingang && npm run typecheck && npm test && npm run build && npm run build:single && npm run build:campus-map-demo && npm run build:project-preview && npm run verify:single && npm run verify:campus-map-demo && npm run verify:project-preview",
    "map:zijingang": "node scripts/verify-zijingang-campus-panorama.mjs && npm run verify:rpg-player",
    "map:zijingang:rebuild": "python3 scripts/calibrate-topdown-campus-runtime.py",
    "map:zijingang:walkability": "python3 scripts/calibrate-topdown-campus-runtime.py",
    "map:zijingang:repository-panorama": "node scripts/verify-zijingang-campus-panorama.mjs",
    "map:zijingang:legacy-tilemap": "node scripts/generate-zijingang-tilemap.mjs",
    "map:zijingang:mosaic": "python3 scripts/build-campus-mosaic.py",
    "map:zijingang:plate": "python3 scripts/generate-zijingang-campus-plate.py",
    "map:zijingang:split": "python3 scripts/split-zijingang-campus-sectors.py",
    "map:zijingang:stitch": "python3 scripts/stitch-zijingang-campus-sectors.py",
    "verify:rpg-player": "node scripts/verify-rpg-player-frames.mjs",
    "art:zijingang": "npm run art:zijingang:landmarks && npm run art:zijingang:environment && npm run art:zijingang:bridge && npm run art:zijingang:terrain",
    "art:zijingang:landmarks": "node scripts/process-zijingang-landmarks.mjs",
    "art:zijingang:environment": "node scripts/process-zijingang-environment-atlas.mjs",
    "art:zijingang:bridge": "node scripts/process-zijingang-bridge.mjs",
    "art:zijingang:terrain": "node scripts/process-zijingang-terrain.mjs",
    "audio:library-finals": "node scripts/generate-library-finals-audio.mjs",
    "audio:act-one": "node scripts/generate-act-one-audio.mjs",
    "audio:bike-arcade": "node scripts/generate-bike-arcade-audio.mjs",
    "audio:chapters:english": "node scripts/generate-act-one-audio.mjs --voice-only && node scripts/generate-library-finals-audio.mjs --voice-only && node scripts/generate-bike-arcade-audio.mjs --voice-only"
  },
  "dependencies": {
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "phaser": "^3.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
