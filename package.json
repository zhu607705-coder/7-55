{
  "name": "seven-fifty-five",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "build:single": "npm run build:demo",
    "verify:single": "node scripts/verify-single-file-build.mjs",
    "dev:library-shelf": "vite --host 0.0.0.0 --open library-shelf-debug.html",
    "dev:canteen-chase": "vite --host 0.0.0.0 --open canteen-chase-debug.html",
    "dev:finale-npcs": "vite --host 0.0.0.0 --open finale-npc-debug.html",
    "dev:finale-environments": "vite --host 0.0.0.0 --open finale-environment-debug.html",
    "dev:chapter4-stairs3d": "vite --host 0.0.0.0 --open chapter4-monument-stair-demo.html",
    "art:theater": "node scripts/build-theater-art-assets.mjs",
    "build:campus-map-demo": "tsc --noEmit && vite build --mode campus-demo",
    "build:chapter4-stairs3d": "npm run chapter4:validate-stair-materials && tsc --noEmit && vite build --config vite.chapter4-stairs3d.config.ts",
    "verify:campus-map-demo": "node scripts/verify-single-file-build.mjs campus-map-demo.html",
    "map:zijingang": "node scripts/verify-zijingang-topdown-campus.mjs && node scripts/verify-zijingang-campus-panorama.mjs && npm run verify:rpg-player",
    "map:zijingang:rebuild": "python3 scripts/build-zijingang-loop-panorama.py && python3 scripts/calibrate-wide-campus-runtime.py && npm run map:zijingang",
    "map:zijingang:topdown": "node scripts/verify-zijingang-topdown-campus.mjs",
    "map:zijingang:tilemap": "node scripts/generate-zijingang-tilemap.mjs && node scripts/verify-zijingang-tilemap.mjs",
    "map:zijingang:loop": "python3 scripts/calibrate-wide-campus-runtime.py && node scripts/verify-zijingang-campus-panorama.mjs",
    "map:zijingang:walkability": "npm run map:zijingang:loop",
    "map:zijingang:topdown-reference": "python3 scripts/calibrate-topdown-campus-runtime.py",
    "map:zijingang:repository-panorama": "node scripts/verify-zijingang-campus-panorama.mjs",
    "map:zijingang:legacy-tilemap": "npm run map:zijingang:tilemap",
    "map:zijingang:mosaic": "python3 scripts/build-campus-mosaic.py",
    "map:zijingang:plate": "python3 scripts/generate-zijingang-campus-plate.py",
    "map:zijingang:split": "python3 scripts/split-zijingang-campus-sectors.py",
    "map:zijingang:stitch": "python3 scripts/stitch-zijingang-campus-sectors.py",
    "verify:rpg-player": "node scripts/verify-rpg-player-frames.mjs",
    "verify:rpg-facing-agnostic": "node scripts/verify-rpg-facing-agnostic.mjs",
    "chapter4:validate-story": "node scripts/verify-chapter4-755-story.mjs",
    "chapter4:validate-runtime": "node scripts/verify-chapter4-755-runtime.mjs",
    "chapter4:validate-task14": "node scripts/verify-chapter4-755-task14.mjs",
    "chapter4:normalize-assets": "node scripts/normalize-chapter4-755-assets.mjs",
    "chapter4:validate-assets": "node scripts/verify-chapter4-755-assets.mjs",
    "chapter4:validate-topology": "node scripts/verify-chapter4-temporal-maze.mjs",
    "chapter4:validate-stair-materials": "node scripts/verify-chapter4-stair-materials.mjs",
    "qizhen:validate-journal": "node scripts/verify-qizhen-journal.mjs",
    "art:canteen-push-cart": "python3 scripts/build-canteen-push-cart-frames.py",
    "art:finale-npcs": "node scripts/build-finale-npc-atlases.mjs",
    "art:finale-environments": "npm run chapter4:normalize-assets && node scripts/build-finale-environment-manifest.mjs",
    "art:chapter4-prologue": "node scripts/build-chapter4-prologue-pixel-plates.mjs",
    "art:zijingang": "npm run art:zijingang:landmarks && npm run art:zijingang:environment && npm run art:zijingang:bridge && npm run art:zijingang:terrain",
    "art:zijingang:landmarks": "node scripts/process-zijingang-landmarks.mjs",
    "art:zijingang:environment": "node scripts/process-zijingang-environment-atlas.mjs",
    "art:zijingang:bridge": "node scripts/process-zijingang-bridge.mjs",
    "art:zijingang:terrain": "node scripts/process-zijingang-terrain.mjs",
    "audio:library-finals": "node scripts/generate-library-finals-audio.mjs",
    "audio:act-one": "node scripts/generate-act-one-audio.mjs",
    "audio:bike-arcade": "node scripts/generate-bike-arcade-audio.mjs",
    "audio:chapter3-canteen": "node scripts/generate-chapter3-canteen-audio.mjs",
    "audio:chapter3-theater": "node scripts/generate-chapter3-theater-audio.mjs",
    "audio:chapter3-qizhen": "node scripts/generate-chapter3-qizhen-audio.mjs",
    "audio:chapter4-prologue-music": "node scripts/generate-chapter4-prologue-music-audio.mjs",
    "audio:chapter3": "node scripts/generate-chapter3-audio.mjs",
    "audio:chapter3:verify": "node scripts/verify-chapter3-audio-contract.mjs && node scripts/generate-chapter3-audio.mjs --verify-only",
    "audio:chapter3:status": "node scripts/verify-chapter3-audio-contract.mjs --report-only",
    "audio:chapter3:qizhen:checkpoint": "node scripts/generate-chapter3-qizhen-sfx-audio.mjs --checkpoint-existing",
    "audio:chapter4-prologue-sfx": "node scripts/generate-chapter4-prologue-sfx-audio.mjs",
    "audio:chapter4-prologue-voice": "node scripts/generate-chapter4-prologue-voice-audio.mjs",
    "audio:chapters:english": "node scripts/generate-act-one-audio.mjs --voice-only && node scripts/generate-library-finals-audio.mjs --voice-only && node scripts/generate-bike-arcade-audio.mjs --voice-only && node scripts/generate-chapter3-audio.mjs --voice-only"
  },
  "dependencies": {
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "phaser": "^3.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.4",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
