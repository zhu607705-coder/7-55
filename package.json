    "build:single:unchecked": "node --max-old-space-size=6144 node_modules/vite/bin/vite.js build --mode demo",
    "typecheck": "tsc --noEmit",
    "build:single": "npm run build:demo",
    "verify:single": "node scripts/verify-single-file-build.mjs",
    "verify:browser-smoke": "node scripts/verify-browser-smoke.mjs",
    "validate:quick": "node scripts/run-validation-suite.mjs quick",
    "validate:critical": "node scripts/run-validation-suite.mjs critical",
    "validate:extended": "node scripts/run-validation-suite.mjs extended",
    "validate:release": "node scripts/run-validation-suite.mjs release",
    "text:export": "node scripts/export-game-text.mjs",
    "text:check": "node scripts/export-game-text.mjs --check",
    "verify:task-guidance": "node scripts/verify-task-guidance-ownership.mjs",
    "chapter3:validate-interlude": "node scripts/verify-chapter3-interlude-parallel.mjs",
    "verify:developer-levels": "node scripts/verify-developer-channel-levels.mjs",
