    "audio:chapter3-canteen": "node scripts/generate-chapter3-canteen-audio.mjs",
    "audio:chapter3-theater": "node scripts/generate-chapter3-theater-audio.mjs",
    "audio:chapter3-qizhen": "node scripts/generate-chapter3-qizhen-audio.mjs",
    "audio:chapter3-interlude-voice-memos": "node scripts/generate-chapter3-interlude-voice-memos-audio.mjs",
    "audio:chapter3-interlude-voice-memos:verify": "node scripts/generate-chapter3-interlude-voice-memos-audio.mjs --verify-only && node scripts/verify-chapter3-interlude-voice-memos.mjs",
    "audio:chapter4-prologue-music": "node scripts/generate-chapter4-prologue-music-audio.mjs",
    "audio:chapter3": "node scripts/generate-chapter3-audio.mjs",
    "audio:chapter3:verify": "node scripts/verify-chapter3-audio-contract.mjs && node scripts/generate-chapter3-audio.mjs --verify-only",
    "audio:chapter3:status": "node scripts/verify-chapter3-audio-contract.mjs --report-only",
    "audio:chapter3:qizhen:checkpoint": "node scripts/generate-chapter3-qizhen-sfx-audio.mjs --checkpoint-existing",
    "audio:chapter4-prologue-sfx": "node scripts/generate-chapter4-prologue-sfx-audio.mjs",
    "audio:chapter4-prologue-voice": "node scripts/generate-chapter4-prologue-voice-audio.mjs",
    "audio:pursuit": "node scripts/generate-pursuit-audio.mjs",
    "audio:pursuit:verify": "node scripts/generate-pursuit-audio.mjs --verify-only && node scripts/verify-pursuit-audio.mjs",
    "audio:chapter4-details": "node scripts/generate-chapter4-detail-sfx.mjs",
    "audio:chapters:english": "node scripts/generate-act-one-audio.mjs --voice-only && node scripts/generate-library-finals-audio.mjs --voice-only && node scripts/generate-chapter3-audio.mjs --voice-only"
  },
  "dependencies": {
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "phaser": "^3.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.4",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
