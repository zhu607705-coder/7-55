# Local-only credentials match deploy/compose.dev.yml. Never use them in production.
DATABASE_URL=postgresql://platform:platform_local@127.0.0.1:55432/platform
HOST=127.0.0.1
PORT=3001
WEB_PORT=5174
NODE_ENV=development
SERVE_WEB=false
# Exact browser origin; production uses https://your-domain. No trailing path.
PUBLIC_ORIGIN=http://127.0.0.1:5174
# Set to 1 only behind a single trusted proxy with no public API port.
TRUST_PROXY=false
# Authing hosted authentication. Leave ALL THREE empty until your app is created.
# See docs/authing-setup.md; never use a VITE_ prefix for these server secrets.
AUTHING_ISSUER=
AUTHING_CLIENT_ID=
AUTHING_CLIENT_SECRET=
# Comma-separated Authing user IDs (OIDC subject); only these users can operate the queue.
OPERATOR_SUBJECTS=
# Development-only: absolute path to a verified Godot Web export; serves /game/ locally.
# Use SERVE_WEB=true and PUBLIC_ORIGIN=http://127.0.0.1:3001 with matching Authing callbacks.
# Do not set this in NODE_ENV=production (use deploy/compose.game.yml).
# LOCAL_GAME_EXPORT_DIR=/absolute/path/to/godot_native/exports/web-release
# Optional verified public HTTPS game link. Blank means no pretend play button.
GAME_URL=
# Only set this to a disposable test database. Tests create/remove their own schema.
# TEST_DATABASE_URL=postgresql://platform:platform_local@127.0.0.1:55432/platform
