{
  "checkedDate": "2026-11-02",
  "client": "Codex CLI 0.166.0-alpha.5.1",
  "serverName": "hi3d",
  "transport": "streamable_http",
  "url": "https://agent.hi3d.cn/mcp",
  "authentication": "OAuth",
  "authVerified": true,
  "verification": [
    "Native Codex MCP status discovers11tools",
    "get_capabilities succeeds",
    "get_balance succeeds",
    "upload_input succeeds",
    "quote_generation succeeds"
  ],
  "nativeChatToolCatalog": "This pre-existing chat has no hot-added hi3d namespace. Native Codex MCP protocol calls work without restarting the app. Refresh/reopen a chat to expose its native tool names.",
  "credentialHandling": "OAuth remains in Codex native credential storage. No bearer token is exported to project files.",
  "tools": [
    {
      "name": "upload_input",
      "description": "上传纯 Base64 参考图，返回当前用户的临时 file_token，有效24小时。单图最多 10 MiB。历史生成图片优先通过 source_images 引用任务，不要重新上传或重用过期令牌。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 14680064
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ]
          }
        },
        "required": [
          "image_base64",
          "mime_type"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "create_generation",
      "description": "收费操作。只有用户明确确认当前预估后，才传 confirmed=true。调用真实 hi3d-codex 生成接口；每份报价只能提交一次。不自动重试。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quote_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "confirmed": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "quote_id",
          "confirmed"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "create_image_generation",
      "description": "国内环境仅支持 Seedream v4.5 文生图与图片编辑，不支持多视图生图。用户要求生图后可直接提交，无需单独确认。历史图片通过 source_images 引用任务图片（image_index 从0开始），不要复用过期 file_token。提交只调用一次，不自动重试。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_type": {
            "type": "string",
            "const": "image2d",
            "default": "image2d"
          },
          "operation": {
            "type": "string",
            "enum": [
              "text_to_image",
              "edit"
            ],
            "default": "text_to_image"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "file_tokens": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 4,
            "default": []
          },
          "model_name": {
            "type": "string",
            "enum": [
              "Seedream v4.5"
            ],
            "default": "Seedream v4.5"
          },
          "source_task_id": {
            "$ref": "#/properties/file_tokens/items"
          },
          "source_images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "task_id": {
                  "$ref": "#/properties/file_tokens/items"
                },
                "image_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "default": 0
                }
              },
              "required": [
                "task_id"
              ],
              "additionalProperties": false
            },
            "maxItems": 4,
            "description": "历史生成图片引用，按建模视图顺序排列；图片序号从0开始。优先使用此字段复用历史图片，不要复用24小时过期的 file_token / Historical task images in view order; zero-based indexes. Prefer these references over expired upload tokens."
          },
          "source_image_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 29,
            "default": 0
          },
          "multi_view": {
            "type": "boolean",
            "const": false,
            "default": false
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4"
            ],
            "default": "1:1"
          },
          "style": {
            "type": "string",
            "enum": [
              "",
              "stone-sculpture",
              "sci-fi-armor",
              "steampunk",
              "filigree-ivory",
              "urban-art"
            ],
            "default": ""
          },
          "presets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 10,
            "default": []
          },
          "quote_id": {
            "$ref": "#/properties/file_tokens/items"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
