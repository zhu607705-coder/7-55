    {
      "name": "quote_generation",
      "description": "Free local-price quote; quote the complete image set once, not once per image. Do not repeatedly quote unchanged parameters. Input ownership and validity are checked on submission. Default to high_quality, model_with_texture and PBR enabled; use master only when explicitly requested. Chinese and English product names are accepted. v3.0 master=quality, high_quality=standard; v2.0/v2.1 high_quality=quality. Use model_with_texture or model_only. source_image_number starts at 1 and is optional; output format is fixed by the server. 按本地价格配置计算积分并查询余额，同一组完整图片与参数只报价一次，不要逐张图报价或重复报价。素材读取和有效性校验在提交时执行。默认高质版、模型与贴图、PBR开启；仅用户明确要求大师版时选大师。生成类型用“模型与贴图”或“仅模型”；v3.0 大师、高质，v2.1 快速、高质，v2.0 均衡、高质。source_task_id 指定历史图片任务；仅需非第一张时填写 source_image_number（从1开始）。输出格式由服务端固定，无需填写。文档价格就是本次生成费用。 历史生成图片（包括前几天生成的多视图）优先使用 source_images: [{task_id,image_index}]，最多4张，image_index从0开始，按视图顺序排列。提交时自动取得原图并刷新临时上传令牌。不要同时传这些图片的旧 file_tokens；不要与 source_task_id 混用。Prefer source_images for historical results; never reuse expired upload tokens.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          },
          "file_tokens": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 4,
            "default": []
          },
          "source_task_id": {
            "$ref": "#/properties/file_tokens/items",
            "description": "历史图片任务编号 / Source image task ID. 直接上传时不填 / Omit when using uploaded images."
          },
          "source_images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "task_id": {
                  "$ref": "#/properties/file_tokens/items"
                },
                "image_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 29,
                  "default": 0
                }
              },
              "required": [
                "task_id"
              ],
              "additionalProperties": false
            },
            "maxItems": 4,
            "description": "历史生成图片引用，按建模视图顺序排列；图片序号从0开始。优先使用此字段复用历史图片，不要复用24小时过期的 file_token / Historical task images in view order; zero-based indexes. Prefer these references over expired upload tokens."
          },
          "version": {
            "type": "string",
            "enum": [
              "v3.0",
              "v2.1",
              "v2.0"
            ],
            "default": "v3.0"
          },
          "model_type": {
            "type": "string",
            "enum": [
              "大师",
              "高质",
              "快速",
              "均衡",
              "master",
              "high_quality",
              "fast",
              "balanced"
            ],
            "default": "high_quality",
            "description": "质量 / Quality: 大师=master, 高质=high_quality, 快速=fast, 均衡=balanced. v3.0: master/high_quality; v2.1: fast/high_quality; v2.0: balanced/high_quality. 不填默认高质版 / Defaults to high_quality, not master."
          },
          "generation_type": {
            "type": "string",
            "enum": [
              "模型与贴图",
              "仅模型",
              "model_with_texture",
              "model_only"
            ],
            "default": "model_with_texture",
            "description": "生成类型 / Generation: 模型与贴图=model_with_texture (geometry + texture); 仅模型=model_only (geometry only)."
          },
          "license": {
            "type": "string",
            "enum": [
              "private",
              "cc-by-4.0"
            ],
            "default": "private",
            "description": "模型许可 / License: private=私有，cc-by-4.0=CC BY 4.0 公开模型。用户要求公开或 CC BY 4.0 时选 cc-by-4.0；未指定默认私有 / Defaults to private; choose cc-by-4.0 when public is requested."
          },
          "pbr": {
            "type": "boolean",
            "default": true,
            "description": "是否开启 PBR 材质 / Enable PBR materials. 带贴图时默认开启；关闭少5积分 / With texture: enabled by default; disable to save 5 points. 仅模型不影响费用 / No price effect for geometry only."
          },
          "source_image_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "历史任务第几张图片，从1开始，默认第1张 / Image number in the source task, starting at 1; omit for the first image. Only used with source_task_id."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
