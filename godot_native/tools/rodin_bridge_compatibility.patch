--- a/rodin_bridge.gd
+++ b/rodin_bridge.gd
@@ -31,9 +31,22 @@
 	RBSettings.instance()._settings["editor_interface"] = e
 
 func _exit_tree() -> void:
-	remove_control_from_bottom_panel(panel)
-	panel.queue_free()
-	task_manager.queue_free()
+	remove_control_from_docks(panel)
+	panel.free()
+	task_manager.free()
+	# The supplied bridge allocates these outside the scene tree. Release them
+	# on disable/editor shutdown rather than leaking scripts into export import.
+	var settings := RBSettings.instance()
+	if is_instance_valid(settings):
+		for key in ["task_manager_inst", "ctx_inst", "props_inst"]:
+			var owned = settings._settings.get(key)
+			if is_instance_valid(owned): owned.free()
+		for client in settings._settings.get("client", {}).values():
+			if is_instance_valid(client): client.free()
+		settings._settings.clear()
+		ProjectSettings.set_initial_value("rodin_setting_inst", null)
+		ProjectSettings.set_setting("rodin_setting_inst", null)
+		settings.free()
 
 func _handles(object: Object) -> bool:
 	return true
