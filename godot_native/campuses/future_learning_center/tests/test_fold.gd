extends SceneTree
const Model=preload("res://campuses/future_learning_center/scripts/puzzles/fold_model.gd")
var checks:=0
var failures:=0
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures+=1;printerr("FOLD_FAIL: "+label)
func operate(m)->void:m.start();m.step(1)
func _initialize()->void:
	_run.call_deferred()
func _run()->void:
	var m=Model.new()
	check(m.fully_open() and m.legal(0,0) and m.legal(1,0),"initial geometry legal")
	operate(m);check(m.operated,"same sample operates unfolded")
	m.swing_to(0,PI)
	check(m.angles[0]<PI-.1 and m.contact_kind=="cable","fast rotation stops at actual cable")
	check(not m.completed,"blocked fold cannot certify")
	m.swing_to(0,0);m.change_route(1);operate(m)
	m.swing_to(1,PI);m.swing_to(0,PI)
	check(m.contact_kind=="leaf" and m.angles[0]<PI-.1,"wide-first blocks narrow swept arc")
	m.swing_to(0,0);m.swing_to(1,0);m.swing_to(0,PI);m.swing_to(1,PI)
	check(m.completed and m.envelope_fits(),"narrow then wide is geometric solution")
	check(m.proofs.size()==1,"one unchanged instance proof")
	m=Model.new();m.set_connected(false);m.swing_to(0,PI);m.swing_to(1,PI)
	check(m.envelope_fits() and not m.completed,"unplugged fold fits but cannot complete")
	check(not m.set_connected(true),"cannot teleport cable into closed box")
	m=Model.new();m.change_route(2);operate(m)
	m.swing_to(0,PI*.85);m.swing_to(1,PI*.5);m.swing_to(0,PI);m.swing_to(1,PI)
	check(m.completed,"overlapping partial motions are legal alternative, not whitelist")
	m.swing_to(1,0);m.swing_to(0,0);m.set_attachment(true)
	check(not m.operated and not m.extension_completed,"accessory invalidates empty-box trial")
	m.change_route(1);check(m.cable_pinched() and not m.start(),"accessory occupies actual front groove")
	m.change_route(2);operate(m);m.swing_to(0,PI);m.swing_to(1,PI)
	check(m.extension_completed,"rear groove works with attached final part")
	m=Model.new();m.change_route(1);m.begin_gesture();m.swing_to(0,1);m.cancel_pointer()
	check(m.undo() and m.angles[0]==0 and not m.operated,"canceled movement is reversible, no fabricated operation")
	m.start();m.step(.2);m.stop();m.step(1)
	check(not m.operated,"focus stop rejects pending electrical proof")
	check(not m.swing_to(-1,PI) and not m.swing_to(0,NAN),"invalid angle inputs rejected")
	# Enumerate both full-cover orders and all routes from fresh instances.
	for path:int in 3:
		for first:int in 2:
			var sample=Model.new();sample.change_route(path);operate(sample)
			sample.swing_to(first,PI);sample.swing_to(1-first,PI)
			check(sample.completed==(path>0 and first==0),"enumerated route/order geometry %d/%d"%[path,first])
	m=Model.new();m.change_route(1);operate(m);m.set_connected(false);m.set_connected(true);m.swing_to(0,PI);m.swing_to(1,PI)
	check(not m.completed,"disconnect/reconnect cannot retain earlier working proof")
	if "--with-view" in OS.get_cmdline_user_args():
		var v=load("res://campuses/future_learning_center/scripts/puzzles/fold_view.gd").new()
		root.add_child(v);v.open()
		var touch:=InputEventScreenTouch.new();touch.index=2;touch.pressed=true;touch.position=v.model.tip(0);v._input(touch)
		check(v.touch_id==2 and v.leaf==0,"finger owns real narrow-cover handle")
		var other:=InputEventScreenTouch.new();other.index=3;other.pressed=true;other.position=v.SWITCH;v._input(other)
		check(v.touch_id==2 and not v.model.running,"second finger cannot steal handle or start trial")
		var drag:=InputEventScreenDrag.new();drag.index=2;drag.position=v.model.tip(0,1);v._input(drag)
		check(v.model.angles[0]>.9,"drag changes actual hinge geometry")
		touch.pressed=false;touch.canceled=true;v._input(touch)
		var kept:float=v.model.angles[0];drag.position=v.model.tip(0,2);v._input(drag)
		check(v.touch_id==-1 and is_equal_approx(kept,v.model.angles[0]),"cancel keeps legal angle and rejects late drag")
		var mouse:=InputEventMouseButton.new();mouse.device=InputEvent.DEVICE_ID_EMULATION;mouse.button_index=MOUSE_BUTTON_LEFT;mouse.pressed=true;mouse.position=v.PLUG;v._input(mouse)
		check(v.action.is_empty() and v.model.connected,"emulated press never toggles connector")
		v.model.swing_to(0,0);v.model.start();v.model.step(.2);v._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT);v.model.step(1)
		check(not v.model.operated and not v.model.running,"focus cancels current operation without forging proof")
		v.model.start();v.close();v.model.step(1)
		check(not v.visible and not v.model.operated,"close cancels electrical trial")
		v.model=Model.new();v.open()
		v.press(Vector2(350,270));v.release(Vector2(425,318))
		check(v.model.route==1,"dragging physical band seats it into front groove")
		v.press(v.SWITCH);v.release(v.SWITCH);v.model.step(1)
		check(v.model.operated,"physical rotary switch proves unfolded operation")
		for cover:int in 2:
			v.press(v.model.tip(cover));v.motion(v.model.tip(cover,PI));v.release(v.model.tip(cover))
		check(v.model.completed,"full pointer-only interaction reaches actual folded result")
		v.model.swing_to(1,0);v.model.swing_to(0,0)
		v.press(v.ATTACH_TRAY);v.release(Model.ATTACHMENT.get_center())
		check(v.model.attachment and not v.model.operated,"dragging actual attachment invalidates empty-shell evidence")
		v.queue_free()
	print("FLC_FOLD: %d checks, %d failures"%[checks,failures]);quit(failures)
