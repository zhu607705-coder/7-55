extends SceneTree
const Model=preload("res://campuses/future_learning_center/scripts/puzzles/storage_model.gd")
var checks:=0
var failures:=0
func check(value:bool,label:String)->void:
	checks+=1
	if not value:failures+=1;printerr("STORAGE_FAIL: "+label)
func _initialize()->void:
	_run.call_deferred()
func _run()->void:
	var m=Model.new()
	for i:int in 3:check(m.legal(i,m.positions[i]),"initial case legal "+str(i))
	check(not m.move_box(-1,Vector2.ZERO),"invalid identity")
	check(not m.move_box(0,Vector2(NAN,0)),"invalid coordinate")
	m.move_box(0,Vector2(800,258))
	check(m.positions[0].x<=255 and m.contact_kind=="box","fast drag stops at first short box")
	check(not m.taken,"collision cannot mark extraction")
	m.begin_gesture();m.move_box(2,Vector2(535,155));m.end_gesture()
	check(m.positions[2].y==155,"short case into supported upper pocket")
	m.begin_gesture();m.swing_to(PI/2);m.end_gesture()
	check(is_equal_approx(m.door_angle,PI/2),"door swings open through empty swept area")
	m.begin_gesture();m.move_box(1,Vector2(640,255));m.move_box(1,Vector2(640,355));m.end_gesture()
	check(m.positions[1].distance_to(Vector2(640,355))<.1,"one short case can use side tray")
	check(m.is_supported(m.box(1)),"side tray supports complete footprint")
	m.move_box(0,Vector2(650,258))
	check(m.taken and m.completed and m.positions[0].x>626,"actual complete long box crosses door")
	check(not m.box(0).intersects(m.box(1)),"long extraction does not overlap tray case")
	m.swing_to(0)
	check(m.door_angle>0 and m.contact_kind=="door","door cannot swing through extracted case")
	m.swing_to(PI/2)
	m.move_box(0,Model.STARTS[0])
	check(m.returned and m.positions[0].distance_to(Model.STARTS[0])<8,"actual reverse movement returns long box")
	m.move_box(1,Vector2(640,255));m.move_box(1,Model.STARTS[1]);m.move_box(2,Model.STARTS[2]);m.swing_to(0)
	check(is_equal_approx(m.door_angle,0),"all cases can return then close door")
	for i:int in 3:check(m.legal(i,m.positions[i]),"restored case legal "+str(i))
	check(not m.is_supported(Rect2(490,190,70,70)),"partial unsupported footprint rejected")
	m.begin_gesture();m.move_box(2,Vector2(535,155));m.cancel_gesture()
	check(m.undo() and m.positions[2]==Model.STARTS[2],"cancel ends reversible legal gesture")
	check(m.completed,"undo does not retract completed observation")
	m.reset()
	check(not m.taken and not m.returned and m.completed,"reset restarts trial preserving prior completion")
	# Swapping which short box occupies the tray is a geometric alternative, not an order key.
	m.swing_to(PI/2)
	m.move_box(2,Vector2(640,255));m.move_box(2,Vector2(640,355))
	m.move_box(1,Vector2(535,255));m.move_box(1,Vector2(535,155))
	m.move_box(0,Vector2(650,258))
	check(m.taken,"alternate short-box order solves without a whitelist")
	m.move_box(0,Vector2(650,1000))
	check(m.positions[0].y<=286 and m.contact_kind=="support","long case cannot descend into short tray")
	if "--with-view" in OS.get_cmdline_user_args():
		var view=load("res://campuses/future_learning_center/scripts/puzzles/storage_view.gd").new()
		root.add_child(view);view.open()
		view.press(Vector2(555,280));view.motion(Vector2(555,180))
		view._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
		check(view.drag==-1 and view.model.legal(2,view.model.positions[2]),"focus loss ends drag in legal state")
		view.model.reset()
		var touch:=InputEventScreenTouch.new()
		touch.index=2;touch.position=Vector2(555,280);touch.pressed=true
		view._input(touch)
		check(view.touch_id==2 and view.drag==2,"touch captures actual short case")
		var canceled:=InputEventScreenTouch.new()
		canceled.index=2;canceled.canceled=true;canceled.pressed=false
		view._input(canceled)
		check(view.touch_id==-1 and view.drag==-1,"touch cancellation releases case")
		view.press(Vector2(555,280));view.close()
		check(not view.visible and view.drag==-1,"closing releases active manipulation")
		view.queue_free()
	print("FLC_STORAGE: %d checks, %d failures"%[checks,failures])
	quit(1 if failures else 0)
