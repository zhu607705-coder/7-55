extends SceneTree
const Model=preload("res://campuses/future_learning_center/scripts/puzzles/robotics_model.gd")
const View=preload("res://campuses/future_learning_center/scripts/puzzles/robotics_view.gd")
var checks:=0
var failures:=0
func check(value:bool,label:String)->void:
 checks+=1
 if not value:failures+=1;push_error(label)
func _initialize()->void:call_deferred("run")
func finish(m:RefCounted)->void:
 for i:int in 900:m.step(.05)
func run()->void:
 var m=Model.new();m.start();m.step(.1)
 check(not m.loaded and m.cargo_position.x>130 and m.cargo_position.x<165,"loading continuously moves same cargo from cradle")
 finish(m)
 check(m.phase=="blocked" and not m.completed and m.unloaded and not m.loaded,"outbound delivery alone cannot complete")
 check(m.blocked_edge==[2,1] and m.position.distance_to(Model.NODES[2])<15,"reverse stops visibly at forbidden edge")
 check(m.receipts.is_empty(),"failed outbound cannot produce full-loop receipt")
 m.edit("selector",1);m.start();finish(m)
 check(m.phase=="blocked" and m.blocked_edge==[4,1],"second directional module also enforced")
 m.edit("return_direction",1);m.start();var run:int=m.run_id;var revision:int=m.revision;finish(m)
 check(m.completed and m.phase=="done" and m.position==Model.NODES[0],"full directed loop returns empty robot")
 check(m.receipts.size()==1 and m.receipts[0].run_id==run and m.receipts[0].revision==revision and m.receipts[0].cargo_id==run,"one run one configuration one cargo receipt")
 check(m.inward.size()==5 and m.outward.size()==3,"actual outward and return traces retained")
 check(m.cargo_position==Model.NODES[2]+Vector2(40,0) and not m.loaded,"unloaded cargo stays in target cradle")
 m.edit("target",5);m.start();finish(m)
 check(m.transfer_completed and m.receipts[-1].target==5,"other unloading branch also requires actual return")
 m=Model.new();m.edit("selector",1);m.edit("return_direction",1);m.start()
 for i:int in 60:m.step(.05)
 var pos:Vector2=m.position;m.pause();m.step(10)
 check(m.position==pos and m.running,"stop switch preserves paused trial")
 m.resume();finish(m);check(m.completed,"resume same run completes")
 m=Model.new();m.start()
 for i:int in 50:m.step(.05)
 m.edit("selector",1)
 check(not m.running and not m.loaded and m.position==Model.NODES[0] and m.receipts.is_empty(),"editing active track cancels evidence and returns cargo safely")
 m.start();var previous:int=m.run_id;m.cancel();m.start()
 check(m.run_id==previous+1 and not m.unloaded,"new run never stitches an earlier delivery")
 m.step(INF);m.step(-1);check(m.progress==0,"invalid time creates no motion")
 check(not m.edit("target",99) and not m.edit("chapter",1),"invalid edits rejected")
 m=Model.new();m.single_step();var hand_progress:float=m.progress
 check(m.paused and m.running and hand_progress>0,"handwheel advances one bounded step and pauses")
 m.step(10);check(m.progress==hand_progress,"paused handwheel cannot accumulate unattended time")
 m.single_step();check(m.progress>hand_progress and m.run_id==1,"next handwheel step retains run identity")
 var v=View.new();root.add_child(v);v.open()
 v.press_at(v.TURN);v.release_at(v.TURN+Vector2(0,40))
 v.press_at(v.SWITCH+Vector2(0,34));v.release_at(v.SWITCH+Vector2(18,34))
 check(v.model.return_direction==1 and v.model.selector==1,"actual rotation ring and switch handle change graph")
 v.press_at(Model.NODES[0]);v.release_at(Model.NODES[2]);check(v.model.position==Model.NODES[0],"robot cannot be dragged to fake a run")
 v.press_at(v.POWER);finish(v.model);check(v.model.completed,"physical controls complete same-run loop")
 v.press_at(Model.NODES[2]+Vector2(80,0));v.release_at(Model.NODES[5]+Vector2(80,0))
 check(v.model.target==5,"unloading flag moves to actual alternate cradle")
 var t=InputEventScreenTouch.new();t.index=3;t.pressed=true;t.position=v.TURN;v._gui_input(t)
 var other=InputEventScreenTouch.new();other.index=7;other.pressed=false;other.position=v.TURN;v._gui_input(other)
 check(v.drag==0 and v.touch_id==3,"other finger cannot release rotation")
 var e=InputEventMouseButton.new();e.device=InputEvent.DEVICE_ID_EMULATION;e.button_index=MOUSE_BUTTON_LEFT;e.position=v.TURN;e.pressed=false;v._gui_input(e)
 check(v.drag==0,"emulated mouse cannot mutate captured rotation")
 t.canceled=true;v._gui_input(t);check(v.drag==-1 and v.model.return_direction==1,"cancel discards track gesture")
 v.model.start();v.close();v.open();check(not v.model.running and v.model.phase=="idle","close and reopen cancels uncompleted trial")
 v.queue_free();print("robotics: %d checks, %d failures"%[checks,failures]);quit(1 if failures else 0)
