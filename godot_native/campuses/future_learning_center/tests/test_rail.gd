extends SceneTree
const Model=preload("res://campuses/future_learning_center/scripts/puzzles/rail_model.gd")
const View=preload("res://campuses/future_learning_center/scripts/puzzles/rail_view.gd")
var checks:=0
var failures:=0
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures+=1;push_error(label)
func move(m,id:int,target:int)->void:m.dispatch(id,target);m.step(10)
func drag_move(m,id:int,target:int)->void:m.begin_drag(id);m.drag_to(Model.point(target));m.end_drag()
func _initialize()->void:_run.call_deferred()
func _run()->void:
	var m=Model.new()
	check(not m.dispatch(-1,0) and not m.dispatch(0,10),"invalid command")
	move(m,0,8);check(m.positions==[7,8] and m.blocked==8,"mainline collision stops adjacent")
	check(m.undo() and m.positions==[6,8],"undo is one physical cell")
	m=Model.new();move(m,0,4);move(m,0,9)
	check(m.positions[0]==4,"siding requires switch")
	m.toggle_switch();move(m,0,9);check(m.positions[0]==9,"short fits siding")
	m.toggle_switch();move(m,1,0);m.toggle_switch();move(m,0,4);m.toggle_switch();move(m,0,8)
	check(m.completed and m.positions==[8,0],"first symmetric short solution")
	m.undo();check(m.completed,"achievement monotonic")
	m=Model.new();move(m,1,4);m.toggle_switch();move(m,1,9);m.toggle_switch();move(m,0,8);m.toggle_switch();move(m,1,4);m.toggle_switch();move(m,1,0)
	check(m.completed,"second symmetric short solution")
	m.set_extension(true);move(m,0,4);m.toggle_switch();move(m,0,9)
	check(m.occupied(0)==[9,4],"long tail occupies junction")
	m.toggle_switch();move(m,1,0);check(m.positions[1]==5 and m.blocked==4,"tail collision blocks passage")
	m.set_extension(true);m.siding=false;move(m,1,4);m.toggle_switch();move(m,1,9);m.toggle_switch();move(m,0,8);m.toggle_switch();move(m,1,4);m.toggle_switch();move(m,1,0)
	check(m.extension_completed and m.positions==[8,0],"short yields long passes")
	m=Model.new();m.dispatch(0,4);m.step(.2);m.pause();m.step(20)
	check(m.positions[0]==0 and is_equal_approx(m.elapsed,.2),"pause freezes")
	check(m.resume(),"resume succeeds");m.step(.11);check(m.positions[0]==1,"resumed movement")
	m.cancel();m.step(20);check(m.positions[0]==1,"cancel freezes without teleport")
	m.dispatch(0,4);m.step(NAN);m.step(-1);check(m.positions[0]==1,"invalid dt ignored")
	m.toggle_switch();check(not m.running,"switch edit cancels dispatch")
	var v=View.new();root.add_child(v);v.open();v.press_at(v.cell_position(0));v.release_at(Vector2(900,500));check(not v.model.running,"invalid drop unchanged")
	v.press_at(v.cell_position(0));v.cancel_pointer();v.release_at(v.cell_position(4));check(not v.model.running,"cancel rejects late release")
	v.press_at(v.cell_position(0));v.motion_at(v.cell_position(3));check(v.model.positions[0]==3,"drag moves before release without a timer");v.release_at(v.cell_position(3));v.model.step(2);check(not v.model.running and v.model.positions[0]==3,"release does not queue a delayed command")
	v.model.dispatch(1,5);v._notification(View.NOTIFICATION_APPLICATION_FOCUS_OUT);check(v.model.paused,"focus loss pauses")
	v.close();v.model.step(10);check(v.model.positions[1]==8 and not v.model.running,"close cancels pending movement")
	v.model=Model.new()
	check(not v.model.couple_trailer(true) and v.model.positions==[0,8],"cannot couple tail beyond rail without moving engine")
	v.model.positions.assign([2,1])
	check(not v.model.couple_trailer(true) and v.model.lengths==[1,1],"occupied tail cell rejects attachment")
	v.model.positions.assign([1,8])
	v.press_at(View.TRAILER_TRAY);v.release_at(v.cart_position(0))
	check(v.model.extension and v.model.positions==[1,8] and v.model.occupied(0)==[1,0],"drag spare wagon couples with no teleport")
	v.press_at(v.trailer_position());v.release_at(View.TRAILER_TRAY)
	check(not v.model.extension and v.model.positions==[1,8],"drag tail into cradle detaches without resetting cars")
	v.press_at(View.TRAILER_TRAY);v.cancel_pointer();v.release_at(v.cart_position(0))
	check(not v.model.extension,"canceled trailer drag never attaches")
	v.model.dispatch(0,2)
	check(not v.model.couple_trailer(true),"moving engine rejects coupling")
	v.model.cancel();v.press_at(View.TRAILER_TRAY);v.release_at(View.TRAILER_TRAY);v.press_at(v.cart_position(0))
	check(v.model.extension,"two object clicks offer drag alternative")
	v.model=Model.new();v.model.positions.assign([8,0]);v.model.couple_trailer(true)
	move(v.model,0,7);move(v.model,0,8)
	check(not v.model.extension_completed,"adding trailer at finish cannot fabricate long-load transport")
	v.model=Model.new();v.model.positions.assign([1,8]);v.open()
	var touch:=InputEventScreenTouch.new();touch.index=5;touch.pressed=true;touch.position=View.TRAILER_TRAY;v._gui_input(touch)
	check(v.touch_id==5 and v.trailer_drag,"finger captures physical spare trailer")
	var emulated:=InputEventMouseButton.new();emulated.device=InputEvent.DEVICE_ID_EMULATION;emulated.button_index=MOUSE_BUTTON_LEFT;emulated.pressed=false;emulated.position=v.cart_position(0);v._gui_input(emulated)
	check(not v.model.extension and v.trailer_drag,"emulated release cannot couple captured trailer")
	var second:=InputEventScreenTouch.new();second.index=6;second.pressed=false;second.position=v.cart_position(0);v._gui_input(second)
	check(v.touch_id==5 and v.trailer_drag,"second finger cannot release owner trailer")
	touch.pressed=false;touch.canceled=true;touch.position=v.cart_position(0);v._gui_input(touch)
	check(not v.model.extension and not v.trailer_drag and v.touch_id==-1,"touch cancellation does not attach")
	touch.canceled=false;touch.pressed=true;touch.position=View.TRAILER_TRAY;v._gui_input(touch)
	touch.pressed=false;touch.position=v.cart_position(0);v._gui_input(touch)
	check(v.model.extension and v.model.positions==[1,8],"owner finger release couples with stable positions")
	v.model=Model.new();v.cancel_pointer()
	v.press_at(v.cell_position(0)+Vector2(12,-8));v.motion_at(Vector2(212,302))
	check(v.cart_position(0)==Vector2(200,310),"same-event movement retains off-center grip")
	check(v.model.history.is_empty() and not v.model.running,"motion neither adds undo nor schedules animation")
	v.release_at(Vector2(800,310));check(v.cart_position(0)==Vector2(200,310),"far mouseup cannot teleport or dispatch")
	check(v.model.history.size()==1,"whole gesture creates one undo entry")
	v.model.undo();check(v.cart_position(0)==Vector2(160,310),"undo restores original continuous position")
	v.press_at(Vector2(160,310));v.motion_at(Vector2(1000,310))
	check(v.cart_position(0)==Vector2(720,310) and v.model.blocked==8,"one large pointer move cannot cross occupied cart")
	v.cancel_pointer();check(v.cart_position(0)==Vector2(160,310) and v.model.history.is_empty(),"cancel restores initial pose and no gesture history")
	v.press_at(Vector2(160,310));v.motion_at(Vector2(200,310));v.release_at(Vector2(200,310))
	check(v.model.dispatch(0,2) and v.cart_position(0)==Vector2(200,310),"automatic trial starts at retained partial edge")
	v.model.step(.075);check(v.cart_position(0).distance_to(Vector2(220,310))<.01,"automatic trial retains original per-cell timing")
	v.model.step(1);check(v.model.positions[0]==2,"automatic trial continues through partial edge")
	v.model=Model.new();v.press_at(Vector2(160,310));v.motion_at(Vector2(200,310));v.release_at(Vector2(200,310))
	v.model.dispatch(0,0);check(v.cart_position(0)==Vector2(200,310),"automatic reverse begins without snapping")
	v.model.step(.075);check(v.cart_position(0).distance_to(Vector2(180,310))<.01,"automatic return is continuous")
	v.model.step(1);check(v.model.positions[0]==0 and v.model.edge_to[0]==-1,"automatic reverse reaches anchor")
	v.model=Model.new();v.model.set_extension(true)
	v.press_at(v.cart_position(0));v.motion_at(Vector2(280,310))
	check(v.cart_position(0)==Vector2(280,310) and v.trailer_position()==Vector2(200,310),"attached wagon follows engine continuously")
	v.cancel_pointer();check(v.cart_position(0)==Vector2(240,310) and v.trailer_position()==Vector2(160,310),"cancel restores engine and trailer")
	v.model=Model.new();v.model.positions.assign([7,0]);v.press_at(v.cart_position(0));v.motion_at(v.cell_position(8))
	check(not v.model.completed,"reaching terminal during drag is not completion proof")
	v.cancel_pointer();check(not v.model.completed and v.model.positions==[7,0],"canceled arrival cannot certify completion")
	v.press_at(v.cart_position(0));v.motion_at(v.cell_position(8));v.release_at(v.cell_position(8));check(v.model.completed,"normal arrival release certifies actual traversal")
	v.model=Model.new();v.model.positions.assign([4,8]);v.model.toggle_switch()
	v.press_at(v.cart_position(0));v.motion_at(Vector2(480,242))
	check(v.cart_position(0)==Vector2(480,242),"side track drag follows vertical rail immediately")
	v.model.toggle_switch();check(v.model.siding,"switch cannot cut under a straddling cart")
	v.release_at(Vector2(480,242));check(v.cart_position(0)==Vector2(480,242),"long siding edge does not cause large release snap")
	v.model=Model.new();v.cancel_pointer();v.show()
	var down:=InputEventMouseButton.new();down.button_index=MOUSE_BUTTON_LEFT;down.pressed=true;down.position=Vector2(160,310);v._gui_input(down)
	var motion:=InputEventMouseMotion.new();motion.position=Vector2(195,310);v._gui_input(motion)
	check(v.cart_position(0)==Vector2(195,310),"native mouse motion updates pose in same input callback")
	v.cancel_pointer()
	m=Model.new();drag_move(m,0,4);m.toggle_switch();drag_move(m,0,9);m.toggle_switch();drag_move(m,1,0);m.toggle_switch();drag_move(m,0,4);m.toggle_switch();drag_move(m,0,8)
	check(m.completed and m.positions==[8,0],"continuous drag solves short-cart exchange via same topology")
	m=Model.new();m.set_extension(true);drag_move(m,0,4);m.toggle_switch();drag_move(m,0,9);m.toggle_switch();drag_move(m,1,0)
	check(m.positions[1]==5 and m.blocked==4,"continuous drag cannot pass long trailer occupying junction")
	m=Model.new();m.set_extension(true);drag_move(m,1,4);m.toggle_switch();drag_move(m,1,9);m.toggle_switch();drag_move(m,0,8);m.toggle_switch();drag_move(m,1,4);m.toggle_switch();drag_move(m,1,0)
	check(m.extension_completed,"continuous long-cart solution preserves constraints and completion")
	m=Model.new();m.begin_drag(1);m.drag_to(Vector2(760,310));m.end_drag();m.begin_drag(0);m.drag_to(Vector2(800,310))
	check(m.pose(0)==Vector2(640,310),"resting partial cart reserves swept occupancy against another drag")
	m.cancel_drag();m=Model.new();m.positions.assign([4,8]);m.toggle_switch();m.begin_drag(0);m.drag_to(Vector2(480,305))
	check(m.pose(0)==Vector2(480,305),"side-track follows first five pixels without dead-zone")
	m.cancel_drag();m.positions.assign([9,8]);m.begin_drag(0);m.drag_to(Vector2(480,179))
	check(m.pose(0)==Vector2(480,179),"drag exits siding on first five pixels rather than waiting for mainline")
	v.queue_free()
	await process_frame
	print("rail: %s checks, %s failures"%[checks,failures]);quit(1 if failures else 0)
