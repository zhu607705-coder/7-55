extends SceneTree
const Model=preload("res://campuses/future_learning_center/scripts/puzzles/rail_model.gd")
const View=preload("res://campuses/future_learning_center/scripts/puzzles/rail_view.gd")
var checks:=0
var failures:=0
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures+=1;push_error(label)
func move(m,id:int,target:int)->void:m.dispatch(id,target);m.step(10)
func _initialize()->void:_run.call_deferred()
func _run()->void:
	var m=Model.new()
	check(not m.dispatch(-1,0) and not m.dispatch(0,10),"invalid command")
	move(m,0,8);check(m.positions==[7,8] and m.blocked==8,"mainline collision stops adjacent")
	check(m.undo() and m.positions==[6,8],"undo is one physical cell")
	m=Model.new();move(m,0,4);move(m,0,9)
	check(m.positions[0]==4,"siding requires switch")
	m.toggle_switch();move(m,0,9);check(m.positions[0]==9,"short fits siding")
	m.toggle_switch();move(m,1,0);m.toggle_switch();move(m,0,4);m.toggle_switch();move(m,0,8)
	check(m.completed and m.positions==[8,0],"first symmetric short solution")
	m.undo();check(m.completed,"achievement monotonic")
	m=Model.new();move(m,1,4);m.toggle_switch();move(m,1,9);m.toggle_switch();move(m,0,8);m.toggle_switch();move(m,1,4);m.toggle_switch();move(m,1,0)
	check(m.completed,"second symmetric short solution")
	m.set_extension(true);move(m,0,4);m.toggle_switch();move(m,0,9)
	check(m.occupied(0)==[9,4],"long tail occupies junction")
	m.toggle_switch();move(m,1,0);check(m.positions[1]==5 and m.blocked==4,"tail collision blocks passage")
	m.set_extension(true);m.siding=false;move(m,1,4);m.toggle_switch();move(m,1,9);m.toggle_switch();move(m,0,8);m.toggle_switch();move(m,1,4);m.toggle_switch();move(m,1,0)
	check(m.extension_completed and m.positions==[8,0],"short yields long passes")
	m=Model.new();m.dispatch(0,4);m.step(.2);m.pause();m.step(20)
	check(m.positions[0]==0 and is_equal_approx(m.elapsed,.2),"pause freezes")
	check(m.resume(),"resume succeeds");m.step(.11);check(m.positions[0]==1,"resumed movement")
	m.cancel();m.step(20);check(m.positions[0]==1,"cancel freezes without teleport")
	m.dispatch(0,4);m.step(NAN);m.step(-1);check(m.positions[0]==1,"invalid dt ignored")
	m.toggle_switch();check(not m.running,"switch edit cancels dispatch")
	var v=View.new();root.add_child(v);v.open();v.press_at(v.cell_position(0));v.release_at(Vector2(900,500));check(not v.model.running,"invalid drop unchanged")
	v.press_at(v.cell_position(0));v.cancel_pointer();v.release_at(v.cell_position(4));check(not v.model.running,"cancel rejects late release")
	v.press_at(v.cell_position(0));v.release_at(v.cell_position(3));v.model.step(2);check(v.model.positions[0]==3,"drag dispatches cart")
	v.model.dispatch(1,5);v._notification(View.NOTIFICATION_APPLICATION_FOCUS_OUT);check(v.model.paused,"focus loss pauses")
	v.close();v.model.step(10);check(v.model.positions[1]==8 and not v.model.running,"close cancels pending movement")
	v.model=Model.new()
	check(not v.model.couple_trailer(true) and v.model.positions==[0,8],"cannot couple tail beyond rail without moving engine")
	v.model.positions.assign([2,1])
	check(not v.model.couple_trailer(true) and v.model.lengths==[1,1],"occupied tail cell rejects attachment")
	v.model.positions.assign([1,8])
	v.press_at(View.TRAILER_TRAY);v.release_at(v.cart_position(0))
	check(v.model.extension and v.model.positions==[1,8] and v.model.occupied(0)==[1,0],"drag spare wagon couples with no teleport")
	v.press_at(v.trailer_position());v.release_at(View.TRAILER_TRAY)
	check(not v.model.extension and v.model.positions==[1,8],"drag tail into cradle detaches without resetting cars")
	v.press_at(View.TRAILER_TRAY);v.cancel_pointer();v.release_at(v.cart_position(0))
	check(not v.model.extension,"canceled trailer drag never attaches")
	v.model.dispatch(0,2)
	check(not v.model.couple_trailer(true),"moving engine rejects coupling")
	v.model.cancel();v.press_at(View.TRAILER_TRAY);v.release_at(View.TRAILER_TRAY);v.press_at(v.cart_position(0))
	check(v.model.extension,"two object clicks offer drag alternative")
	v.model=Model.new();v.model.positions.assign([8,0]);v.model.couple_trailer(true)
	move(v.model,0,7);move(v.model,0,8)
	check(not v.model.extension_completed,"adding trailer at finish cannot fabricate long-load transport")
	v.model=Model.new();v.model.positions.assign([1,8]);v.open()
	var touch:=InputEventScreenTouch.new();touch.index=5;touch.pressed=true;touch.position=View.TRAILER_TRAY;v._gui_input(touch)
	check(v.touch_id==5 and v.trailer_drag,"finger captures physical spare trailer")
	var emulated:=InputEventMouseButton.new();emulated.device=InputEvent.DEVICE_ID_EMULATION;emulated.button_index=MOUSE_BUTTON_LEFT;emulated.pressed=false;emulated.position=v.cart_position(0);v._gui_input(emulated)
	check(not v.model.extension and v.trailer_drag,"emulated release cannot couple captured trailer")
	var second:=InputEventScreenTouch.new();second.index=6;second.pressed=false;second.position=v.cart_position(0);v._gui_input(second)
	check(v.touch_id==5 and v.trailer_drag,"second finger cannot release owner trailer")
	touch.pressed=false;touch.canceled=true;touch.position=v.cart_position(0);v._gui_input(touch)
	check(not v.model.extension and not v.trailer_drag and v.touch_id==-1,"touch cancellation does not attach")
	touch.canceled=false;touch.pressed=true;touch.position=View.TRAILER_TRAY;v._gui_input(touch)
	touch.pressed=false;touch.position=v.cart_position(0);v._gui_input(touch)
	check(v.model.extension and v.model.positions==[1,8],"owner finger release couples with stable positions")
	v.queue_free()
	await process_frame
	print("rail: %s checks, %s failures"%[checks,failures]);quit(1 if failures else 0)
