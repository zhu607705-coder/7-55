extends SceneTree
const Model=preload("res://campuses/future_learning_center/scripts/puzzles/machinery_model.gd")
var checks:=0
var failures:=0
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures+=1;printerr("MACHINERY_FAIL: "+label)
func cut(m,index:int)->void:m.start_cut(index);m.step(1.1)
func _initialize()->void:_run.call_deferred()
func _run()->void:
	var m=Model.new();check(not m.extract_to(720) and m.contact_kind=="bridge","intact bridge prevents extraction")
	for order:Array in [[0,1,2],[1,0,2],[2,0,1],[2,1,0],[0,2,1],[1,2,0]]:
		m=Model.new();m.place_clamp(1)
		for i:int in order:cut(m,i)
		m.extract_to(720)
		check(m.completed==(order[-1]==2),"observed support physics accepts valid permutations "+str(order))
	m=Model.new();cut(m,0);cut(m,1);cut(m,2);m.extract_to(720)
	check(not m.completed and m.part_rect().end.x<=650 and m.contact_kind=="clamp","fast extraction cannot tunnel through clamp")
	check(m.place_clamp(1),"clamp can move after all cuts")
	m.extract_to(720);check(m.completed and m.geometry_matches(),"moving clamp permits genuinely cut piece extraction")
	m=Model.new();cut(m,2);cut(m,0)
	check(m.displacement.y>0 and not m.valid_cut(0),"unregistered sample actually shifts and retains wrong kerf")
	check(m.undo() and m.progress[0]==0 and m.displacement==Vector2.ZERO,"undo recovers sample and cutting datum")
	m.place_clamp(-1);check(not m.start_cut(0),"unclamped frame cannot be cut")
	m=Model.new();m.start_cut(0);m.step(.4);m.cancel();var p:float=m.progress[0];m.step(2)
	check(m.progress[0]==p and not m.valid_cut(0),"cancel keeps partial physical cut without completion")
	m.start_cut(0);m.step(1);check(m.valid_cut(0),"same cut resumes to full path")
	m=Model.new();m.reset(1);m.place_clamp(2);cut(m,1);cut(m,0);cut(m,2);m.extract_to(120)
	check(m.extension_completed and m.geometry_matches(),"mirrored bridge and extraction side work")
	m=Model.new();m.reset(1);m.place_clamp(2);cut(m,0);cut(m,1);cut(m,2);m.extract_to(720)
	check(not m.completed and m.contact_kind=="frame","copying old extraction direction hits real frame")
	check(not m.start_cut(8) and not m.place_clamp(8) and not m.extract_to(NAN),"invalid input rejected")
	if "--with-view" in OS.get_cmdline_user_args():
		var v=load("res://campuses/future_learning_center/scripts/puzzles/machinery_view.gd").new()
		root.add_child(v);v.open()
		for i:int in 3:
			var at:Vector2=v.model.path_point(v.model.path(i),.5)
			v.press(at);v.release(at);v.model.step(1.1)
		check(v.model.geometry_matches(),"touching actual contour segments performs correct cutting")
		var handle:Vector2=v.model.part_rect().position+Vector2(60,64)
		v.press(handle);v.motion(handle+Vector2(300,0));v.release(handle+Vector2(300,0))
		check(not v.model.completed and v.model.contact_kind=="clamp","real piece drag meets actual exit clamp")
		v.press(v.model.clamp_rect().get_center());v.release(Model.CLAMPS[1].get_center())
		check(v.model.clamp_slot==1,"dragging clamp changes physical frame contact")
		handle=v.model.part_rect().position+Vector2(60,64)
		v.press(handle);v.motion(handle+Vector2(200,0));v.release(handle+Vector2(200,0))
		check(v.model.completed,"pointer-only cut and extraction completes")
		v.model=Model.new()
		var touch:=InputEventScreenTouch.new();touch.index=1;touch.pressed=true;touch.position=v.model.path_point(v.model.path(0),.5);v._input(touch)
		var other:=InputEventScreenTouch.new();other.index=2;other.pressed=true;other.position=Model.CLAMPS[0].get_center();v._input(other)
		check(v.touch_id==1 and v.action=="cut","second finger cannot steal contour selection")
		touch.pressed=false;touch.canceled=true;v._input(touch)
		check(not v.model.running and v.action.is_empty(),"canceled touch never starts a cut")
		v.model.start_cut(0);v.model.step(.4);v._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT);var held:float=v.model.progress[0];v.model.step(3)
		check(v.model.progress[0]==held,"focus loss preserves physical partial kerf")
		v.model.start_cut(0);v.close();v.model.step(3);v.open()
		check(v.model.progress[0]==held and not v.model.completed,"close never finishes cutting in background")
		v.queue_free()
	print("FLC_MACHINERY: %d checks, %d failures"%[checks,failures]);quit(failures)
