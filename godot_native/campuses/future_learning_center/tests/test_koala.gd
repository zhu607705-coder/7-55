extends SceneTree
const Model=preload("res://campuses/future_learning_center/scripts/puzzles/koala_model.gd")
const View=preload("res://campuses/future_learning_center/scripts/puzzles/koala_view.gd")
var checks:=0
var failures:=0
func check(ok:bool,label:String)->void:
 checks+=1
 if not ok:failures+=1;push_error(label)
func finish(m)->void:
 for i:int in 65:m.step(.1)
func verify(m)->void:
 for id:int in 2:m.insert_card(id);m.start();finish(m)
func _initialize()->void:
 for chain:Array in [[5,4,3],[5,4,0,1,2],[5,0,4]]:
  var m=Model.new()
  for id:int in chain:m.attach(id,m.chain.size())
  verify(m);check(m.completed,"function equivalent inverse accepted "+str(chain))
 var m=Model.new()
 for id:int in [0,4,5]:m.attach(id,m.chain.size())
 verify(m);check(not m.completed,"original forward sequence fails asymmetric inputs")
 m=Model.new();m.attach(5,0);m.attach(4,1);m.attach(3,2);m.insert_card(0);m.start();finish(m)
 check(not m.completed and m.frames.size()==4,"one card insufficient, every intermediate preserved")
 m.insert_card(0);m.start();finish(m);check(not m.completed,"repeated same card not new proof")
 var rev:int=m.revision;m.insert_card(1);check(m.revision==rev and m.receipts.has(0),"new input preserves pipeline proof")
 m.start();finish(m);check(m.completed,"second input restored with same pipeline")
 m.attach(3,0);check(m.receipts.is_empty() and m.chain.count(3)==1,"module move is unique and invalidates")
 m.undo();check(m.chain==[5,4,3] and m.receipts.is_empty(),"undo without stale evidence")
 m.edit_token(0,true);check(m.card==-1,"arbitrary token editing makes experimental input")
 m.start();finish(m);check(m.receipts.is_empty(),"custom input cannot stand in for required cards")
 m.insert_card(0);m.start();m.step(.1);m.pause();var elapsed:float=m.elapsed;finish(m);check(m.elapsed==elapsed,"paused pipeline frozen")
 m.resume();finish(m);check(m.receipts.has(0),"resumed pipeline valid")
 check(not m.attach(9,0) and not m.insert_card(3),"invalid IDs rejected")
 var v=View.new();v.press_at(v.module_position(5));v.move_at(v.socket(0));v.release_at(v.socket(0));check(v.model.chain==[5],"drag module into chain")
 v.press_at(v.module_position(4));v.cancel_pointer();v.release_at(v.socket(1));check(v.model.chain==[5],"canceled module drag has no late insert")
 v.press_at(v.card_position(1));v.move_at(View.INPUT_CLAMP.get_center());v.release_at(View.INPUT_CLAMP.get_center());check(v.model.card==1,"physical new input card inserted")
 v.model.start();v._notification(View.NOTIFICATION_APPLICATION_FOCUS_OUT);finish(v.model);check(v.model.receipts.is_empty(),"focus loss cannot finish")
 v.close();finish(v.model);check(not v.model.running,"closed trial canceled")
 v.show()
 var e:=InputEventScreenTouch.new();e.index=10;e.pressed=true;e.position=v.module_position(4);v._gui_input(e)
 e=InputEventScreenTouch.new();e.index=11;e.pressed=true;e.position=v.module_position(3);v._gui_input(e)
 check(v.touch_id==10 and v.held==4,"second finger cannot steal module")
 var mouse:=InputEventMouseButton.new();mouse.device=InputEvent.DEVICE_ID_EMULATION;mouse.button_index=MOUSE_BUTTON_LEFT;mouse.pressed=true;mouse.position=View.CRANK;v._gui_input(mouse)
 check(not v.model.running and v.held==4,"emulated mouse ignored")
 e=InputEventScreenTouch.new();e.index=10;e.canceled=true;e.pressed=false;e.position=v.socket(1);v._gui_input(e)
 v.release_at(v.socket(1));check(v.model.chain==[5] and v.held==-1,"touchcancel and late release preserve module identity")
 v.press_at(v.module_position(4));v.release_at(Vector2(950,530));check(v.model.chain==[5],"outside drop leaves module in tray")
 v.model.start();v.close();finish(v.model);check(v.model.receipts.is_empty(),"close cannot certify pending input")
 v.show()
 e=InputEventScreenTouch.new();e.index=20;e.pressed=true;e.position=v.module_position(4);v._gui_input(e)
 e=InputEventScreenTouch.new();e.index=20;e.pressed=true;e.canceled=true;e.position=v.module_position(4);v._gui_input(e)
 check(v.touch_id==-1 and v.held==-1,"pressed cancellation releases owner")
 e=InputEventScreenTouch.new();e.index=21;e.pressed=true;e.position=v.module_position(4);v._gui_input(e)
 check(v.touch_id==21,"new finger accepted after pressed cancellation")
 v.cancel_pointer()
 var layout=View.new()
 for id:int in [5,4,3]:layout.press_at(layout.module_position(id));layout.move_at(layout.socket(layout.model.chain.size()));layout.release_at(layout.socket(layout.model.chain.size()))
 check(layout.model.chain==[5,4,3],"new physical module rail preserves inverse order")
 layout.press_at(View.CRANK);finish(layout.model);check(layout.model.receipts.has(0) and not layout.model.completed,"new crank actually runs card A")
 layout.press_at(layout.card_position(1));layout.move_at(View.INPUT_CLAMP.get_center());layout.release_at(View.INPUT_CLAMP.get_center());layout.press_at(View.CRANK);finish(layout.model)
 check(layout.model.completed and layout.output_is_current(),"new input clamp and adjacent result complete card B")
 var proof:Dictionary=layout.model.receipts.duplicate(true);var pipeline:Array=layout.model.chain.duplicate()
 layout.press_at(View.NOTEBOOK.get_center());check(layout.paper_open,"physical notebook opens on demand")
 layout.press_at(View.NOTE_PAGE.get_center());check(layout.frame_cursor==4 and layout.model.receipts==proof,"turning history page grants no evidence")
 layout.press_at(layout.socket(0));check(not layout.paper_open and layout.model.chain==pipeline and layout.held==-1,"modal paper dismisses without click through to apparatus")
 layout.press_at(View.GOAL_ORIGIN+Vector2(0,9));check(layout.model.card==-1,"arbitrary fill edits remain on original card")
 check(not layout.output_is_current(),"changed input never labels stale output as current")
 layout.press_at(View.CRANK);finish(layout.model);check(layout.output_is_current(),"custom trial output is current before next edit")
 layout.press_at(View.GOAL_ORIGIN+Vector2(48,9))
 check(not layout.output_is_current(),"custom to custom edit invalidates full input fingerprint and paper label")
 layout.press_at(View.GOAL_ORIGIN+Vector2(48,9))
 check(not layout.output_is_current() and layout.model.frames.is_empty(),"editing back to previous custom input cannot resurrect stale output")
 var drag=View.new()
 var grip:=Vector2(11,9)
 drag.press_at(drag.card_position(1)+grip)
 check(drag.held_center()==drag.card_position(1),"card pickup retains exact grip without jump")
 drag.move_at(Vector2(480,180)+grip)
 check(drag.held_center()==Vector2(480,180) and drag.model.card==0,"same card follows actual motion before commit")
 drag.release_at(View.INPUT_CLAMP.get_center()+grip)
 check(drag.model.card==0 and drag.held_card==-1,"far release cannot teleport card to clamp")
 drag.press_at(drag.card_position(1)+grip);drag.move_at(View.INPUT_CLAMP.get_center()+grip);drag.release_at(View.INPUT_CLAMP.get_center()+grip)
 check(drag.model.card==1,"offset grip card drops at visible clamp pose")
 drag.press_at(drag.module_position(5)+grip)
 check(drag.held_center()==drag.module_position(5),"module pickup retains exact grip")
 drag.move_at(drag.socket(0)+grip)
 check(drag.held_center()==drag.socket(0) and drag.model.chain.is_empty(),"visible module moves without mutating chain")
 drag.cancel_pointer();drag.release_at(drag.socket(0)+grip)
 check(drag.model.chain.is_empty(),"cancel motion then release cannot insert module")
 drag.press_at(drag.module_position(5)+grip);drag.release_at(drag.socket(0)+grip)
 check(drag.model.chain.is_empty(),"module far release without motion rejected")
 drag.press_at(drag.module_position(5)+grip);drag.move_at(drag.socket(0)+grip);drag.release_at(drag.socket(0)+grip)
 check(drag.model.chain==[5],"module commits visible near slot with offset grip")
 drag.press_at(drag.module_position(4));drag.move_at(drag.socket(6));drag.release_at(drag.socket(6))
 check(drag.model.chain==[5],"empty distant slot cannot teleport into next chain slot")
 drag.free()
 layout.free()
 v.free();print("koala: %d checks, %d failures"%[checks,failures]);quit(1 if failures else 0)
