extends SceneTree
const Model=preload("res://campuses/future_learning_center/scripts/puzzles/access_model.gd")
var checks:=0
var failures:=0
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures+=1;printerr("ACCESS_FAIL: "+label)
func _initialize()->void:_run.call_deferred()
func _run()->void:
	var m=Model.new()
	m.slide_to(185);check(m.insertion==0 and m.contact_kind=="entry","closed cover blocks actual side entry")
	m.swing_to(PI/2);check(m.loose and not m.completed,"loose lid is not a hinge connection")
	m.set_cover(false);m.slide_to(185)
	check(m.connected() and m.through_hole(0) and m.through_hole(1),"shaft physically traverses both holes")
	m.set_cover(true);check(not m.completed,"assembled positions alone are not completion")
	m.swing_to(PI/2);check(not m.completed,"opening alone is insufficient")
	m.swing_to(0);check(m.completed,"real open and close proves one assembly")
	m=Model.new();m.set_cover(false);m.slide_to(174)
	check(m.through_hole(0) and not m.through_hole(1),"partial insertion only reaches first hole")
	check(m.set_cover(true),"cover can attach after shaft clears lip, before second hole")
	m.slide_to(185);m.swing_to(PI/2);m.swing_to(0)
	check(m.completed,"geometric alternative order works")
	m=Model.new();m.set_cover(false);m.slide_to(10)
	check(not m.set_cover(true),"cannot place lip through partly inserted shaft")
	m.slide_to(185);check(not m.set_support(0,false),"threaded ring cannot be removed radially")
	m.slide_to(0);check(m.set_support(0,false) and m.set_support(1,false),"unthreaded supports removable")
	m.slide_to(185);m.set_cover(true);m.swing_to(PI/2)
	check(not m.connected() and not m.completed,"floating shaft without supports is not accepted")
	m.set_cover(false);m.slide_to(0);m.set_support(1,true);m.set_support(0,true);m.set_side(1);m.slide_to(185);m.set_cover(true);m.swing_to(PI/2);m.swing_to(0)
	check(m.extension_completed,"mirrored hinge side retains real solution")
	m=Model.new();m.set_cover(false);m.slide_to(185);m.set_cover(true);m.swing_to(PI/2);m.set_cover(false);m.set_cover(true);m.swing_to(0)
	check(not m.completed,"reassembly invalidates earlier opening proof")
	check(not m.slide_to(NAN) and not m.swing_to(INF) and not m.set_side(4),"invalid coordinates rejected")
	for a:int in 91:check(m.cover_clear(deg_to_rad(a)),"actual body clear throughout angle "+str(a))
	if "--with-view" in OS.get_cmdline_user_args():
		var v=load("res://campuses/future_learning_center/scripts/puzzles/access_view.gd").new()
		root.add_child(v);v.open()
		v.press(v.cover_tab());v.release(v.COVER_TRAY)
		check(not v.model.cover,"drag cover ear removes cover")
		var handle:Vector2=v.shaft_handle();v.press(handle);v.motion(handle+Vector2(185,0));v.release(v.shaft_handle())
		check(v.model.connected(),"dragging shaft handle traverses actual bores")
		v.press(v.COVER_TRAY);v.release(Vector2(440,320))
		v.press(v.cover_handle());v.motion(Vector2(440,141));v.release(v.cover_handle())
		v.press(v.cover_handle());v.motion(Vector2(440,357));v.release(v.cover_handle())
		check(v.model.completed,"pointer-only assembly and continuous opening completes")
		var touch:=InputEventScreenTouch.new();touch.index=1;touch.pressed=true;touch.position=v.cover_handle();v._input(touch)
		var other:=InputEventScreenTouch.new();other.index=2;other.pressed=true;other.position=v.shaft_handle();v._input(other)
		check(v.touch_id==1 and v.action=="lid","second touch cannot steal cover")
		touch.pressed=false;touch.canceled=true;v._input(touch)
		check(v.action.is_empty() and v.touch_id==-1,"cancellation does not perform drop action")
		var mouse:=InputEventMouseButton.new();mouse.device=InputEvent.DEVICE_ID_EMULATION;mouse.button_index=MOUSE_BUTTON_LEFT;mouse.pressed=true;mouse.position=v.cover_tab();v._input(mouse)
		check(v.action.is_empty(),"emulated mouse ignored")
		v.press(v.cover_handle());v._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
		check(v.action.is_empty(),"focus loss ends hinge drag")
		v.press(v.cover_tab());v.close();v.release(v.COVER_TRAY)
		check(v.model.cover and not v.visible,"late release after close cannot detach cover")
		v.queue_free()
	print("FLC_ACCESS: %d checks, %d failures"%[checks,failures]);quit(failures)
