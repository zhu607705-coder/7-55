extends SceneTree
const Model=preload("res://campuses/future_learning_center/scripts/puzzles/coupled_model.gd")
const View=preload("res://campuses/future_learning_center/scripts/puzzles/coupled_view.gd")
var checks:=0
var failures:=0
func check(value:bool,label:String)->void:
 checks+=1
 if not value:failures+=1;push_error(label)
func _initialize()->void:call_deferred("run")
func run()->void:
 var m=Model.new()
 check(m.insert_pin(),"initial touching squares accept pin")
 check(not m.move_piece(0,Vector2(450,160)),"horizontal linked width 2 cannot cross width 1.4")
 check(m.positions[0].y<400 and m.positions[0].y>=359.99,"failed sweep advances to legal boundary")
 m=Model.new();m.insert_pin()
 check(not m.move_piece(0,Vector2(100,400)),"off-tray movement rejected")
 m=Model.new();m.insert_pin()
 check(m.rotate_to(PI/2),"lower wide bay permits longitudinal rotation")
 check(m.move_piece(0,Vector2(480,260)),"longitudinal pair enters neck")
 check(not m.rotate_to(0),"rotation sweep in narrow neck hits real edges")
 m.rotate_to(PI/2)
 check(m.move_piece(0,Vector2(480,140)),"longitudinal pair passes entirely into upper bay")
 check(m.rotate_to(0),"upper bay permits rotation onto terminals")
 m.finish_gesture();check(m.completed and m.circuit_closed(),"legal intact alternative accepted")
 m=Model.new()
 check(not m.move_piece(0,Vector2(600,400)),"sweep detects occupied block along route, not just endpoint")
 check(m.move_piece(1,Vector2(600,400)),"second block clears entrance")
 check(m.move_piece(0,Vector2(480,400)),"first block aligns with throat")
 check(m.move_piece(0,Vector2(480,170)),"single block crosses neck")
 check(m.move_piece(0,Vector2(360,170)),"first block parks in wide bay")
 check(m.move_piece(1,Vector2(480,400)),"second block aligns")
 check(m.move_piece(1,Vector2(480,170)),"second block crosses neck")
 check(m.move_piece(1,Vector2(510,170)),"second terminal reached")
 check(m.move_piece(0,Vector2(450,170)),"first terminal reached")
 m.finish_gesture();check(not m.completed and not m.circuit_closed(),"two unlinked contacts never illuminate")
 check(m.insert_pin(),"pin links terminals only after geometric contact")
 m.finish_gesture();check(m.completed,"separate transit solution accepted")
 m=Model.new();m.positions[1]=Vector2(650,400)
 check(not m.insert_pin(),"pin cannot remotely link separated blocks")
 check(not m.move_piece(0,Vector2(NAN,1)),"nonfinite destination rejected")
 var fast=Model.new();var slow=Model.new();fast.insert_pin();slow.insert_pin()
 var revision:int=fast.revision
 fast.move_piece(0,Vector2(450,170))
 for y:int in range(399,169,-1):slow.move_piece(0,Vector2(450,y))
 check(fast.positions[0].distance_to(slow.positions[0])<.01,"big and small translation reach same boundary")
 check(fast.valid_pose(fast.positions,fast.angle) and fast.revision==revision+1,"partial sweep stays legal with one revision")
 check(not fast.completed,"collision cannot grant completion")
 check(fast.move_piece(0,fast.positions[0]+Vector2(0,30)),"retreat from edge remains possible")
 fast=Model.new();fast.insert_pin();fast.rotate_to(PI/2);fast.move_piece(0,Vector2(480,260))
 slow=Model.new();slow.restore(fast.snapshot());revision=fast.revision
 fast.rotate_to(0)
 for i:int in 100:slow.rotate_to(PI/2*(1-float(i+1)/100))
 check(absf(fast.angle-slow.angle)<.0001,"large and small rotation stop at same contact")
 check(fast.angle<PI/2 and fast.angle>0 and fast.valid_pose(fast.positions,fast.angle),"rotation advances to legal contact, not through wall")
 check(fast.revision==revision+1,"rotation increments revision once")
 check(fast.rotate_to(PI/2),"reverse rotation recovers from boundary")
 var v=View.new();root.add_child(v);v.open()
 v.press_at(v.PIN_TRAY);v.release_at(v.model.midpoint())
 check(v.model.connected,"actual pin drag inserts")
 v.press_at(v.model.midpoint());v.release_at(v.PIN_TRAY)
 check(not v.model.connected,"actual pin drag extracts")
 var start:Vector2=v.model.positions[0]
 v.press_at(start);v.move_at(start+Vector2(-60,0))
 check(v.model.positions[0]==start+Vector2(-60,0),"direct block drag moves geometry")
 v.cancel_pointer();check(v.model.positions[0]==start,"cancellation restores reversible pose")
 var touch=InputEventScreenTouch.new();touch.index=4;touch.pressed=true;touch.position=start
 v._gui_input(touch)
 var other=InputEventScreenTouch.new();other.index=5;other.pressed=false;other.position=start+Vector2(-60,0)
 v._gui_input(other);check(v.touch_id==4 and v.drag==0,"other finger cannot release captured block")
 var synthetic=InputEventMouseButton.new();synthetic.device=InputEvent.DEVICE_ID_EMULATION;synthetic.button_index=MOUSE_BUTTON_LEFT;synthetic.pressed=false;synthetic.position=start+Vector2(-60,0)
 v._gui_input(synthetic);check(v.drag==0,"emulated mouse cannot release touch")
 touch.canceled=true;v._gui_input(touch);check(v.drag==-1 and v.touch_id==-1,"pressed cancellation clears owner")
 v.press_at(v.PIN_TRAY);v.release_at(v.model.midpoint())
 v.press_at(v.handle());v.move_at(v.model.midpoint()+Vector2(57,0));v.release_at(v.model.midpoint()+Vector2(57,0))
 check(absf(v.model.angle-PI/2)<.01,"physical rotation handle turns connected body")
 v.press_at(v.model.positions[0]);v.move_at(Vector2(480,140));v.release_at(Vector2(480,140))
 check(v.model.positions[0].distance_to(Vector2(480,140))<.01,"direct drag takes linked pair through neck")
 v.press_at(v.handle());v.move_at(v.model.midpoint()+Vector2(0,-57));v.release_at(v.model.midpoint()+Vector2(0,-57))
 check(v.model.completed and v.model.circuit_closed(),"real gestures complete intact alternative")
 v.model.undo();check(not v.model.circuit_closed(),"undo returns last rotation without soft lock")
 v.press_at(v.model.midpoint());v.move_at(v.PIN_TRAY);v.cancel_pointer()
 check(v.model.connected,"cancel extracting pin restores mechanical link")
 v.close();check(not v.visible and v.drag==-1,"native close releases capture")
 v.queue_free();print("coupled: %d checks, %d failures"%[checks,failures]);quit(1 if failures else 0)
