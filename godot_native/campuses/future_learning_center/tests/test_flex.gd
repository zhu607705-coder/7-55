extends SceneTree
const Model=preload("res://campuses/future_learning_center/scripts/puzzles/flex_model.gd")
var checks:=0
var failures:=0
func check(value:bool,label:String)->void:
	checks+=1
	if not value:failures+=1;printerr(label)
func pulse(m:RefCounted)->void:m.start();m.step(2)
func _initialize()->void:
	_run.call_deferred()
func _run()->void:
	var m=Model.new()
	pulse(m);check(not m.station_proofs[0],"one unchanged signal is not proof")
	pulse(m);check(m.station_proofs[0],"two changed patterns prove first station")
	m.move_to(1);pulse(m);pulse(m)
	check(not m.station_proofs[1],"copied screen coordinates do not prove second station")
	for i:int in 3:m.edit(i,-1)
	for i:int in 3:m.edit(i,[1,2,0][i])
	pulse(m);pulse(m);check(m.completed,"functional rewiring completes both stations")
	check(not m.edit(0,2),"occupied socket rejects duplicate plug")
	m.route_cable(0,false);pulse(m);check(m.outcomes[0]=="blocked","crossing fixture blocks pulse")
	check(m.completed,"accepted completion remains monotonic")
	m.route_cable(0,true);m.set_short(true);pulse(m);check(m.outcomes[0]=="short","short outer wire cannot span route")
	for i:int in 3:m.edit(i,-1)
	for i:int in 3:m.edit(i,i)
	m.rotate_adapter();m.rotate_adapter();pulse(m);pulse(m)
	check(m.records[-1].valid,"rotated adapter is a valid alternate short-line solution")
	var n=Model.new();n.start();n.step(.4);n.pause();var p:float=n.progress;n.step(10)
	check(n.progress==p,"focus pause stops propagation")
	n.resume();n.step(2);check(n.records.size()==1,"resume finishes once")
	n.start();n.edit(0,-1);n.step(3);check(n.records.size()==1,"editing cancels stale trial")
	n.start();n.cancel();n.step(3);check(n.records.size()==1,"close cancels in-flight result")
	check(not n.move_to(8) and not n.edit(-1,0),"invalid inputs rejected")
	var geometry=Model.new()
	check(is_equal_approx(geometry.path_length(geometry.cable_path(0)),260.0),"straight route uses measured port spacing")
	check(is_equal_approx(geometry.path_length(geometry.cable_path(1)),416.0),"middle outer route has measured pillar detour")
	for i:int in 3:
		check(geometry.obstruction_distance(geometry.cable_path(i))<0,"default outer cable actually clears pillar "+str(i))
	geometry.route_cable(1,false)
	check(geometry.cable_status(1)=="blocked","same endpoint index does not exempt middle pillar intersection")
	geometry.route_cable(0,false)
	check(geometry.cable_status(0)=="clear","upper inner cable physically misses pillar")
	var hit:=PackedVector2Array([Vector2(350,300),Vector2(610,300)])
	check(is_equal_approx(geometry.obstruction_distance(hit),121.0),"continuous segment catches first inflated pillar edge")
	var miss:=PackedVector2Array([Vector2(350,239),Vector2(610,239)])
	check(geometry.obstruction_distance(miss)<0,"one-pixel clearance outside cable radius is legal")
	var tangent:=PackedVector2Array([Vector2(350,240),Vector2(610,240)])
	check(geometry.obstruction_distance(tangent)>=0,"cable-radius tangent counts as contact")
	check(geometry.point_at_distance(hit,121)==Vector2(471,300),"pulse stops at same rendered collision coordinate")
	for i:int in 3:geometry.edit(i,-1)
	geometry.edit(0,1);geometry.route_cable(0,true);geometry.set_short(true)
	check(is_equal_approx(geometry.path_length(geometry.cable_path(0)),434.0),"outer transverse path measures 434 pixels")
	check(geometry.cable_status(0)=="short" and geometry.failure_distance(0)==430.0,"short cable ends four pixels before destination")
	geometry.set_short(false)
	check(geometry.cable_status(0)=="clear","same geometric route fits long cable")
	if "--with-view" in OS.get_cmdline_user_args():
		var view=load("res://campuses/future_learning_center/scripts/puzzles/flex_view.gd").new()
		root.add_child(view);view.open()
		var touch:=InputEventScreenTouch.new();touch.index=0;touch.pressed=true;touch.position=Vector2(230,465)
		view._input(touch)
		check(not view.model.short_cable,"touch press defers spool change until owned release")
		var mouse:=InputEventMouseButton.new();mouse.device=InputEvent.DEVICE_ID_EMULATION;mouse.button_index=MOUSE_BUTTON_LEFT;mouse.pressed=true;mouse.position=touch.position
		view._input(mouse)
		check(not view.model.short_cable,"emulated mouse cannot commit pending spool action")
		touch.pressed=false;view._input(touch);view._input(mouse)
		check(view.model.short_cable,"late emulated press is ignored after touch release")
		touch.pressed=true;touch.position=Vector2(350,232);view._input(touch)
		check(view.dragging==0,"touch captures cable")
		touch.pressed=false;touch.canceled=true;touch.position=Vector2(610,302);view._input(touch)
		check(view.dragging==-1 and view.selected==-1 and view.model.connections==[0,1,2],"cancel clears selection without connecting destination")
		view.press(Vector2(350,232));view._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
		check(view.selected==-1 and view.dragging==-1,"focus loss clears cable selection")
		view.press(Vector2(350,232));view.close();view.open()
		check(view.selected==-1,"reopen cannot retain canceled selection")
		view.model.edit(1,-1);view.press(Vector2(610,302))
		check(view.model.connections==[0,-1,2],"destination alone does not connect stale cable")
		view.model=Model.new()
		var grip:Vector2=view.route_grip(1)
		view.press(grip);view.release(view.route_seat(1,false))
		check(not view.model.outer[1] and view.model.cable_status(1)=="blocked","drag cable grip into inner guide changes real path and collision")
		view.press(view.route_grip(1));view.release(view.route_seat(1,true))
		check(view.model.outer[1] and view.model.cable_status(1)=="clear","drag grip around pillar restores physical clearance")
		view.press(view.route_grip(1));view._clear_drag();view.release(view.route_seat(1,false))
		check(view.model.outer[1],"canceled guide drag preserves routing")
		view.press(view.route_grip(1));view.release(view.route_grip(1));view.press(view.route_seat(1,false))
		check(not view.model.outer[1],"guide objects support two-click alternative")
		view.press(Vector2(480,120));view.release(Vector2(790,205))
		check(view.model.station==1,"handle drag seats same board in second physical dock")
		view.queue_free()
	print("FLC_FLEX: %d checks, %d failures"%[checks,failures]);quit(failures)
