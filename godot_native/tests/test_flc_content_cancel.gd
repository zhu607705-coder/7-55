extends "res://tests/test_web_content.gd"
func begin_optional(coordinator:Node,result:Array)->void:
 result.append(await coordinator.ensure_families(["chapter2","flc_activity"],true))
func run()->void:
 if not load("res://tests/native_test_isolation.gd").is_isolated_save():quit(2);return
 fixture_directory=ProjectSettings.globalize_path("user://flc-content-cancel")
 DirAccess.make_dir_recursive_absolute(fixture_directory)
 var state:Node=root.get_node("State");var before:Dictionary=state.d.duplicate(true)
 var a:=record("chapter2_flc_cancel","chapter2");var f:=record("flc_activity_cancel","flc_activity")
 var transport:=Transport.new();var coordinator:=new_probe([a,f],transport)
 var optional:Array=[];var story:Array=[]
 begin_optional(coordinator,optional);begin_wait(coordinator,["chapter2"],story)
 check(coordinator._cancel_optional_button.visible and coordinator._waiters.size()==2,"optional load presents cancel alongside independent story waiter")
 coordinator._cancel_optional_button.pressed.emit()
 check(optional==[false] and story.is_empty() and coordinator._waiters.size()==1,"cancel abandons only optional activity caller")
 check(coordinator.is_blocking(),"story loading remains blocked until its own data arrives")
 deliver(coordinator,a.id)
 check(story==[true] and not coordinator.is_blocking(),"story waiter completes normally after optional cancellation")
 deliver(coordinator,f.id)
 check(optional==[false] and coordinator._waiters.is_empty(),"late activity pack never resurrects canceled entry")
 var retry:Array=[];begin_optional(coordinator,retry)
 check(retry==[true],"explicit reentry reuses correctly mounted late pack")
 var failed:=new_probe([a,f],Transport.new());var result:Array=[];begin_optional(failed,result)
 deliver(failed,a.id);deliver(failed,f.id,"network unavailable")
 check(result.is_empty() and failed._retry.visible and failed._cancel_optional_button.visible,"failed optional load offers retry and return")
 failed._retry.pressed.emit();deliver(failed,f.id)
 check(result==[true] and not failed.is_blocking(),"actual failed optional pack retries successfully")
 var old:=new_probe([a],Transport.new());var missing:Array=[];begin_optional(old,missing)
 check(missing.is_empty() and old._cancel_optional_button.visible,"old manifest missing optional family can return")
 old.cancel_optional_flc()
 check(missing==[false] and old._fatal_error.is_empty() and not old.is_blocking(),"cancel optional manifest problem does not poison story loader")
 var parallel:=new_probe([a,f],Transport.new());var first:Array=[];var second:Array=[]
 begin_optional(parallel,first);begin_optional(parallel,second);parallel.cancel_optional_flc()
 check(second==[false] and first.is_empty() and parallel._waiters.size()==1,"cancel targets current optional waiter, not another optional caller")
 parallel.cancel_optional_flc();check(first==[false] and not parallel.is_blocking(),"remaining optional caller can cancel independently")
 parallel.free()
 check(state.d==before,"loading failure retry cancellation never change any story or inventory state")
 for node in [coordinator,failed,old]:node.free()
 print("FLC_CONTENT_CANCEL %d checks; %d failures"%[checks,failures]);quit(1 if failures else 0)
