extends SceneTree
const Model=preload("res://scripts/presentation/liangzhu_performance_model.gd")
var checks:=0
var failures:=0
func _initialize()->void:run.call_deferred()
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures+=1;push_error("LIANGZHU_QTE: "+label)
func run()->void:
	var model=Model.new()
	check(not model.qte_input("catch").accepted,"input outside the active cue cannot pre-complete a future action")
	model.tick(15.5)
	check(model.status=="waiting" and model.elapsed_ms==15000 and model.active_qte.id=="catch-fan","a long real frame lands exactly on the first cue without spending its response window")
	var pose:Dictionary=model.snapshot();model.tick(.5)
	check(model.elapsed_ms==15000 and model.active_qte.elapsedMs==500 and model.snapshot().actors==pose.actors,"waiting preserves the current stage while its own active clock runs")
	check(model.snapshot().qte.hintTier==0 and model.snapshot().qte.helpText=="" and model.snapshot().qte.prompt=="接扇","first display contains a short physical action without default timing instructions")
	check(not model.qte_input("butterfly","press").accepted and model.qte_completed.is_empty(),"a different action cannot solve the current cue")
	model.tick(6)
	check(model.status=="failure" and model.active_qte.feedback!="" and model.elapsed_ms==15000,"missing pauses locally with branch feedback")
	var frozen_runtime:float=model.runtime_ms;model.tick(10)
	check(model.runtime_ms==frozen_runtime and model.elapsed_ms==15000,"failure never consumes playback or the next retry window")
	check(model.retry_qte() and model.status=="waiting" and model.active_qte.attempts==2,"retry continues this cue rather than restarting the act")
	check(model.qte_input("catch").accepted and model.qte_completed.has("catch-fan") and model.status=="playing","ordinary tap catches the fan once")
	check(not model.qte_input("catch").accepted and model.qte_results.size()==1,"duplicate input cannot count a second success")
	check(not model.set_playback_mode("passive"),"mode cannot change mid-run to counterfeit interactive completion")
	model.tick(14)
	check(model.status=="waiting" and model.elapsed_ms==29000 and model.qte_completed.has("catch-fan"),"the next cue preserves the earlier successful action")
	check(not model.qte_input("turn","swipe","right").accepted and model.status=="failure","turning away from the authored direction gives a local retry")
	model.retry_qte();check(not model.request_qte_help().is_empty(),"optional layered help can explain input after observation feedback")
	check(model.qte_input("turn","swipe","left","touch:2").accepted and model.qte_results.size()==2,"touch and keyboard share the same direction judgment")
	model.tick(17)
	check(model.status=="waiting" and model.active_qte.action=="butterfly" and model.elapsed_ms==46000,"the final hold cue precedes the48-second release")
	check(not model.qte_input("butterfly","release","","touch:3").accepted,"release without a press never creates a hold")
	check(model.qte_input("butterfly","press","","touch:3").accepted,"one physical owner starts the hold")
	model.tick(.2)
	check(not model.qte_input("butterfly","press","","keyboard").accepted and not model.qte_input("butterfly","release","","keyboard").accepted,"another input device cannot steal or finish the held gesture")
	check(not model.qte_input("butterfly","release","","touch:3").accepted and model.status=="failure" and model.qte_results.size()==2,"early release retries only the final beat")
	model.retry_qte();model.qte_input("butterfly","press","","keyboard");model.tick(.4);model.pause();model.tick(20)
	check(not model.qte_snapshot().holding and model.elapsed_ms==46000 and model.qte_results.size()==2,"pause cancels an in-flight hold without failure or success")
	model.resume();check(not model.qte_input("butterfly","release","","keyboard").accepted,"a stale release after pause cannot finish a new gesture")
	model.qte_input("butterfly","press","","touch:4");model.tick(.3);model.interrupt_input("resize");model.tick(30)
	check(model.focus_paused and not model.qte_snapshot().holding and model.elapsed_ms==46000,"resize interrupts input and waits for explicit resume without spending the window")
	model.resume();model.qte_input("butterfly","press","","touch:5");model.tick(.2,false);model.tick(10,true)
	check(model.focus_paused and not model.qte_snapshot().holding and model.status=="waiting","lost focus cannot finish a hold or auto-resume")
	model.resume();model.tick(.1,true,true)
	check(not model.qte_input("butterfly","press","","keyboard").accepted,"host modal blocks new input as well as time")
	model.tick(.1,true,false);model.qte_input("butterfly","press","","keyboard");model.tick(.9)
	check(model.qte_snapshot().holdProgress==1.0 and model.status=="waiting","a settled fan still requires a real release")
	check(model.qte_input("butterfly","release","","keyboard").accepted and model.qte_results.size()==3,"valid hold-release resolves one actual final action")
	check(model.tick(8) and model.status=="complete" and model.qte_completed.size()==3,"three earned runtime actions allow ordinary playback to reach its end")
	var cancel=Model.new();cancel.tick(15);cancel.cancel();cancel.tick(5)
	check(cancel.status=="cancelled" and cancel.active_qte.is_empty() and not cancel.qte_input("catch").accepted,"cancel retires the local session and its gesture owner")
	var passive=Model.new(false,"passive");passive.tick(54)
	check(passive.status=="complete" and passive.qte_results.is_empty(),"explicit watching remains possible without recording fabricated QTE receipts")
	var overhold=Model.new();overhold.tick(15);overhold.qte_input("catch");overhold.tick(14);overhold.qte_input("turn","swipe","left");overhold.tick(17)
	overhold.qte_input("butterfly","press","","mouse:0");overhold.tick(2.5)
	check(overhold.status=="failure" and overhold.qte_results.size()==2 and not overhold.qte_snapshot().holding,"holding too long is a recoverable final-cue miss, never an automatic pass")
	overhold.retry_qte();overhold.qte_input("butterfly","press","","mouse:0");overhold.cancel()
	check(overhold.active_qte.is_empty() and not overhold.qte_input("butterfly","release","","mouse:0").accepted,"cancel during a hold clears the old physical owner")
	print("LIANGZHU_QTE: %d checks; %d failures"%[checks,failures]);quit(1 if failures else 0)
