  "groups": {
    "canteen_tray_intro": {
      "lines": [
        {
          "text": "阿姨：同学，来得正好。大厅有三只沾油的盘子，帮我收回来，给你两块钱。",
          "atMs": 0,
          "durationMs": 2380
        },
        {
          "text": "玩家：阿姨，我其实是来追一张飞进来的签到纸的……",
          "atMs": 2500,
          "durationMs": 2380
        },
        {
          "text": "阿姨：正好，它刚贴着桌子飞。蹭过的盘子在暗处泛蓝，看到就顺手端回来。",
          "atMs": 5000,
          "durationMs": 2380
        }
      ],
      "completeAtMs": 7500
    },
    "canteen_tray_complete": {
      "lines": [
        {
          "text": "阿姨：这只对，油渍和蓝光都在。",
          "atMs": 0,
          "durationMs": 2380
        },
        {
          "text": "阿姨：三只齐了。两块零钱和这张纸巾，拿着。",
          "atMs": 2500,
          "durationMs": 2380
        },
        {
          "text": "玩家：食堂收盘子还真有日结啊？",
          "atMs": 5000,
          "durationMs": 2380
        },
        {
          "text": "阿姨：今天有。快去忙你的，别踩回收传送带。",
          "atMs": 7500,
          "durationMs": 2380
        },
        {
          "text": "系统：零钱 +2.00 元。",
          "atMs": 10000,
          "durationMs": 2380
        }
      ],
      "completeAtMs": 12500
    },
    "canteen_tray_done": {
      "lines": [
        {
          "text": "阿姨：盘子放履带，别站上去。",
          "atMs": 0,
          "durationMs": 2380
        }
      ],
      "completeAtMs": 2500
    },
    "canteen_tray_return": {
      "lines": [
        {
          "text": "阿姨：这只对，油渍和蓝光都在。",
          "atMs": 0,
          "durationMs": 2380
        }
      ],
      "completeAtMs": 2500
    },
    "canteen_queue": {
      "lines": [
        {
          "text": "玩家：借过一下，我想去三号窗口点个单。",
          "atMs": 0,
          "durationMs": 2380
        },
        {
          "text": "同学：前面全堵着呢。水吧说要上新品，样品还没摆出来，都等着试喝。",
          "atMs": 2500,
          "durationMs": 2380
        }
      ],
      "completeAtMs": 5000
    },
    "canteen_bad_drink": {
      "lines": [
        {
          "text": "玩家：呕……黑咖啡和板蓝根是一个味的吗？",
          "atMs": 0,
          "durationMs": 2380
        },
        {
          "text": "系统：先把杯子腾出来。再调一次，这回按货架顺序倒。",
          "atMs": 2500,
          "durationMs": 2380
        }
      ],
      "completeAtMs": 5000
    },
    "canteen_queue_shift": {
      "lines": [
        {
          "text": "玩家：刚摆上去，怎么人都往后退了？",
          "atMs": 0,
          "durationMs": 2380
        },
        {
          "text": "系统：看那三层颜色，换我也退。点餐机让出来了，过去吧。",
          "atMs": 2500,
          "durationMs": 2380
        }
      ],
      "completeAtMs": 5000
    },
    "canteen_order_correct": {
      "lines": [
        {
          "text": "系统：纸包鸡已经下单。拿好 0755 取餐号。",
          "atMs": 0,
          "durationMs": 2380
        }
      ],
      "completeAtMs": 2500
    },
    "canteen_order_wrong": {
      "lines": [
        {
          "text": "点餐机：已下单",
          "atMs": 0,
          "durationMs": 2380
        }
      ],
      "completeAtMs": 2500
    },
    "canteen_pickup_clue": {
      "lines": [
        {
          "text": "残影阿姨：……票……",
          "atMs": 0,
          "durationMs": 2380
        }
      ],
      "completeAtMs": 2500
    },
    "canteen_escape": {
      "lines": [
        {
          "text": "阿姨：纸不能打包带走。",
          "atMs": 0,
          "durationMs": 1080
        },
        {
          "text": "玩家：它自己跑出去的。",
          "atMs": 1200,
          "durationMs": 1080
        },
        {
          "text": "系统：出门，继续追。",
          "atMs": 2400,
          "durationMs": 1080
        }
      ],
      "completeAtMs": 3600
    },
    "theater_entry": {
      "lines": [
        {
          "text": "检票员：请出示票。",
          "atMs": 0,
          "durationMs": 2400
        },
        {
          "text": "玩家：刚才那张纸进去了，我想进去看看。",
          "atMs": 2520,
          "durationMs": 3520
        },
        {
          "text": "检票员：纸进去我管不着，人进去要验票。今晚好像有同学临时来不了。",
          "atMs": 6160,
          "durationMs": 4960
        }
      ],
      "completeAtMs": 11240
    },
    "theater_printed": {
      "lines": [
        {
          "text": "取票机：回执已核验。补打的票根缺了左半边，场次和票号仍能辨认。",
          "atMs": 0,
          "durationMs": 4840
        }
      ],
      "completeAtMs": 4960
    },
    "theater_combined": {
      "lines": [
        {
          "text": "玩家：同一场，票号也一样。",
          "atMs": 0,
          "durationMs": 2800
        },
        {
          "text": "玩家：接上了。买票还得自己装。",
          "atMs": 2920,
          "durationMs": 3040
        }
      ],
      "completeAtMs": 6080
    },
    "theater_admission": {
      "lines": [
        {
          "text": "检票员：你自己拼的？",
          "atMs": 0,
          "durationMs": 2400
        },
        {
          "text": "玩家：两半都在，码也没缺。",
          "atMs": 2520,
          "durationMs": 2800
        },
        {
          "text": "检票员：能扫。进去吧，票根先别扔。",
          "atMs": 5440,
          "durationMs": 3160
        }
      ],
      "completeAtMs": 8720
    },
    "theater_wrong_order": {
      "lines": [
        {
          "text": "灯控台：顺序不符，请核对节目单。",
          "atMs": 0,
          "durationMs": 3040
        },
        {
          "text": "系统：台上的顺序改过，印刷版未必跟得上。",
          "atMs": 3160,
          "durationMs": 3640
        }
      ],
      "completeAtMs": 6920
    },
    "theater_prop_ghost": {
      "lines": [
        {
          "text": "残影里能看见一把荧光粉刷。实体箱锁着，右侧连着一个读票器。",
          "atMs": 0,
          "durationMs": 5080
        },
        {
          "text": "封条写着“凭本场票根领用道具”。把验过的票根放到右侧读票器上。",
          "atMs": 5200,
          "durationMs": 5320
        }
      ],
      "completeAtMs": 10640
    },
    "theater_console": {
      "lines": [
        {
          "text": "灯控台：请输入节目顺序。",
          "atMs": 0,
          "durationMs": 2560
        },
        {
          "text": "当前状态：追光灯锁定。",
          "atMs": 2680,
          "durationMs": 2400
        }
      ],
      "completeAtMs": 5200
    },
    "theater_reversal_before": {
      "lines": [
        {
          "text": "玩家：抓到了！",
          "atMs": 0,
          "durationMs": 2400
        },
        {
          "text": "系统：先翻过来看。",
          "atMs": 2520,
          "durationMs": 2400
        }
      ],
      "completeAtMs": 5040
    },
    "theater_reversal_after": {
      "lines": [
        {
          "text": "玩家：道具编号？",
          "atMs": 0,
          "durationMs": 2400
        },
        {
          "text": "玩家：我抢票进来，抓了个替身？",
          "atMs": 2520,
          "durationMs": 3040
        },
        {
          "text": "系统：替身有编号。原件去向不在节目单里。",
          "atMs": 5680,
          "durationMs": 3640
        }
      ],
      "completeAtMs": 9440
    },
    "qizhen_approach": {
      "lines": [
        {
          "text": "吸饱了水的真纸条从剧场东门蹿出去，贴着柏油路面向东狂飙。",
          "atMs": 0,
          "durationMs": 2400
        },
        {
          "text": "玩家：剧场外头连个鬼影都没了，它往哪边飞了？",
          "atMs": 2520,
          "durationMs": 2800
        },
        {
          "text": "夜风把路面的水痕吹得七零八落，只剩几滴断续的湿印子。",
          "atMs": 5440,
          "durationMs": 2400
        },
        {
          "text": "系统：水迹断在岔路口了。翻过刚捡到的湿节目单看看，背面还留着一道像馆藏条码的水印。",
          "atMs": 7960,
          "durationMs": 2800
        },
        {
          "text": "水迹到了岔路口彻底消失，黑灯瞎火的，光靠肉眼根本分不清它拐进了哪片水。",
          "atMs": 10880,
          "durationMs": 2400
        },
        {
          "text": "玩家：追了大半个紫金港，合着还得靠赛博破案是吧？",
          "atMs": 13400,
          "durationMs": 2800
        },
        {
          "text": "系统：把湿节目单拖进 CC98 目击搜索和图书馆馆藏检索，再看看微信里有没有人拍到什么。",
          "atMs": 16320,
          "durationMs": 4200
        }
      ],
      "completeAtMs": null
    }
  },
