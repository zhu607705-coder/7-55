        }
      ],
      "completeAtMs": 9440
    },
    "qizhen_approach": {
      "lines": [
        {
          "text": "湿纸从剧场门边飞出，贴着路面向东移动。",
          "atMs": 0,
          "durationMs": 2400
        },
        {
          "text": "玩家：它去哪了？",
          "atMs": 2520,
          "durationMs": 2800
        },
        {
          "text": "路边只留下几段不连续的水迹。",
          "atMs": 5440,
          "durationMs": 2400
        },
        {
          "text": "系统：水迹断了，附近没人看清。",
          "atMs": 7960,
          "durationMs": 2800
        },
        {
          "text": "水迹在湖畔一侧中断，无法直接确认地点。",
          "atMs": 10880,
          "durationMs": 2400
        },
        {
          "text": "玩家：追了一路，还得发帖寻物。",
          "atMs": 13400,
          "durationMs": 2800
        },
        {
          "text": "系统：论坛有人路过，馆藏里也留着借阅记录。",
          "atMs": 16320,
          "durationMs": 4200
        }
      ],
      "completeAtMs": null
    }
