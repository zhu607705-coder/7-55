    "theater_reversal_before": {
      "lines": [
        {
          "text": "玩家：抓到了！",
          "atMs": 0,
          "durationMs": 2400
        },
        {
          "text": "系统：先翻过来看。",
          "atMs": 2520,
          "durationMs": 2400
        }
      ],
      "completeAtMs": 5040
    },
    "theater_reversal_after": {
      "lines": [
        {
          "text": "玩家：道具编号？",
          "atMs": 0,
          "durationMs": 2400
        },
        {
          "text": "玩家：我抢票进来，抓了个替身？",
          "atMs": 2520,
          "durationMs": 3040
        },
        {
          "text": "系统：替身有编号。原件去向不在节目单里。",
          "atMs": 5680,
