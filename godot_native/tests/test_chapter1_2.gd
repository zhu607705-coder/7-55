	act("lib_generate_pass")
	expect(not s.ui.libraryFinalsPuzzle.passBriefingSeen,"PASS generation does not acknowledge unseen dialogue")
	_finish_library_story("library_seat_release_pass_issued")
	act("lib_apply_pass")
	_finish_library_story("library_backpack_evicted")
	act("lib_sit")
	act("lib_dialogue_next")
	expect(s.native.chapter == 2,"one dialogue line cannot finish chapter")
	for i in range(19): act("lib_dialogue_next")
	expect(s.native.chapter == 2,"legacy dialogue buttons cannot bypass opening transition")
	var opening_host:=Node.new()
	var opening: RefCounted=c.library.scene_session(s)
	expect(opening.attach(s,opening_host),"controller opening attaches to native host")
	while opening.status=="playing": opening.advance_current(s,opening_host)
	act("lib_opening_complete",opening)
	opening_host.free()
	expect(s.native.chapter == 3 and s.canteenHunt.active,"full 022 conversation and transition unlock chapter three")
	expect(s.items.campusCard and s.digits.d1 == "0","chapter handoff preserves prior inventory and evidence")
