const Controller = preload("res://scripts/chapters/chapter1_2.gd")
var c = Controller.new()
var s: Dictionary
var checks = 0
var failures = 0
func expect(value: bool, label: String) -> void:
	checks += 1
	if not value:
		failures += 1
		push_error("FAILED: " + label)
func act(id: String, value: Variant = null) -> Dictionary:
	return c.dispatch(s,id,value)
