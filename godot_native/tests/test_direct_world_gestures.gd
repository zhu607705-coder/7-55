extends SceneTree
const Gestures=preload("res://scripts/direct_world_gestures.gd")
var checks:=0
var failures:=0
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures+=1;push_error("DIRECT WORLD GESTURE: "+label)
func _initialize()->void:
	var g=Gestures.new();var state:Dictionary={"fact":false};var context:Array=["room",Vector2(960,540)]
	check(g.begin(1,Vector2(50,100),"map",context,state).is_empty(),"a press cannot dispatch an interaction")
	check(g.drag(1,Vector2(56,100),context,state).is_empty(),"small finger tremor stays a tap candidate")
	var result:Dictionary=g.end(1,Vector2(56,100),false,context,state)
	check(result.get("kind")=="tap" and result.point==Vector2(56,100),"one ordinary up emits one exact scene tap")
	check(g.end(1,Vector2(56,100),false,context,state).is_empty(),"duplicate release has no owner")
	g.begin(2,Vector2(50,100),"map",context,state)
	check(g.drag(2,Vector2(66,100),context,state).get("kind")=="pan","threshold commits a drag owner")
	g.drag(2,Vector2(50,100),context,state)
	check(g.end(2,Vector2(50,100),false,context,state).is_empty(),"drag back to origin never turns into tap")
	g.begin(3,Vector2(50,100),"map",context,state)
	check(g.end(3,Vector2(50,100),true,context,state).is_empty(),"cancelled finger cannot dispatch")
	g.begin(4,Vector2(100,100),"map",context,state);g.begin(5,Vector2(200,100),"map",context,state)
	result=g.drag(5,Vector2(250,120),context,state)
	check(result.get("kind")=="camera" and result.ratio>1 and result.delta.length()>0,"two fingers share one pan and pinch owner")
	check(g.end(4,Vector2(100,100),false,context,state).is_empty(),"first camera release emits no scene tap")
	g.begin(6,Vector2(300,180),"map",context,state)
	check(g.end(6,Vector2(300,180),false,context,state).is_empty(),"new finger cannot restore a tap before old camera fingers lift")
	check(g.end(5,Vector2(250,120),false,context,state).is_empty() and not g.has_active(),"last camera release clears owner without a tap")
	g.begin(7,Vector2(50,100),"map",context,state)
	check(g.end(7,Vector2(50,100),false,context,state).get("kind")=="tap","a fresh all-up sequence can tap again")
	g.begin(8,Vector2(50,100),"map",context,state)
	check(g.end(8,Vector2(50,100),false,["other_room",Vector2(960,540)],state).is_empty() and not g.has_active(),"scene generation change retires stale release")
	g.begin(9,Vector2(50,100),"map",context,state)
	check(g.end(9,Vector2(50,100),false,context,state.duplicate(true)).is_empty(),"equal values in a replacement save do not transfer pointer ownership")
	g.begin(10,Vector2(50,100),"map",context,state);g.cancel()
	check(g.end(10,Vector2(50,100),false,context,state).is_empty(),"focus or layout cancellation never sends release")
	g.begin(11,Vector2(50,100),"paddle_left",context,state);g.begin(12,Vector2(55,100),"paddle_left",context,state)
	check(g.end(12,Vector2(55,100),false,context,state).is_empty(),"second pointer cannot steal an owned physical paddle")
	result=g.end(11,Vector2(50,140),false,context,state)
	check(result.get("kind")=="stroke" and result.side=="left" and result.reverse,"original paddle owner emits one existing reverse stroke")
	g.begin(13,Vector2(50,100),"water_right",context,state)
	check(g.end(13,Vector2(50,100),false,context,state).is_empty(),"bare water is not an invisible tap button")
	g.begin(14,Vector2(50,100),"water_right",context,state)
	result=g.end(14,Vector2(50,70),false,context,state)
	check(result.get("kind")=="stroke" and result.side=="right" and not result.reverse,"boat-side water gesture keeps existing forward intent")
	g.begin(15,Vector2(50,100),"furniture",context,state);g.drag(15,Vector2(100,100),context,state)
	check(g.end(15,Vector2(100,100),false,context,state).is_empty(),"furniture pointer remains with the native drag owner")
	check(state=={"fact":false},"pointer recognition cannot mutate domain state")
	print("DIRECT_WORLD_GESTURES: %d checks; %d failures"%[checks,failures]);quit(1 if failures else 0)
