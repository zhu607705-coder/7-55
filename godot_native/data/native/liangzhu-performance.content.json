    {"id":"study-opening","startMs":0,"endMs":2000,"speaker":"","text":"同窗三载，临别时仍有话未说。","delivery":"caption"},
    {"id":"study-scholar","startMs":2000,"endMs":5500,"speaker":"梁山伯","text":"这一页，你总比我先读懂。","delivery":"spoken"},
    {"id":"study-yingtai","startMs":5500,"endMs":9200,"speaker":"祝英台","text":"书上能读，心里未必。","delivery":"spoken"},
    {"id":"farewell-question","startMs":9200,"endMs":15000,"speaker":"祝英台","text":"梁兄，可看见路边那一双蝶？","delivery":"original-sung"},
    {"id":"farewell-answer","startMs":15000,"endMs":18000,"speaker":"梁山伯","text":"看见了。我再送你一程。","delivery":"spoken"},
    {"id":"farewell-silence","startMs":18000,"endMs":20000,"speaker":"","text":"仍有话未说。","delivery":"caption"},
    {"id":"chamber-opening","startMs":20000,"endMs":23000,"speaker":"","text":"再相见，英台的婚事已被定下。","delivery":"caption"},
    {"id":"chamber-yingtai","startMs":23000,"endMs":29000,"speaker":"祝英台","text":"你认出我时，婚事已定。","delivery":"spoken"},
    {"id":"chamber-scholar","startMs":29000,"endMs":33500,"speaker":"梁山伯","text":"我认得的，一直是你。","delivery":"original-sung"},
    {"id":"chamber-silence","startMs":33500,"endMs":38000,"speaker":"","text":"两人隔桌相望。","delivery":"caption"},
    {"id":"grave-later","startMs":38000,"endMs":42000,"speaker":"","text":"后来，山伯病逝。英台来到墓前。","delivery":"caption"},
    {"id":"grave-yingtai","startMs":42000,"endMs":46000,"speaker":"祝英台","text":"这一次，换我来寻你。","delivery":"spoken"},
    {"id":"butterfly-verse-a","startMs":46000,"endMs":49000,"speaker":"合声","text":"一袖春风，半窗旧梦。","delivery":"original-sung"},
    {"id":"butterfly-verse-b","startMs":49000,"endMs":52500,"speaker":"合声","text":"双蝶并起，再过重门。","delivery":"original-sung"},
    {"id":"butterfly-ending","startMs":52500,"endMs":54000,"speaker":"","text":"蝶影越过重门。","delivery":"caption"}
