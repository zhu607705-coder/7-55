extends SceneTree
const Model = preload("res://scripts/library_model.gd")
var failures := 0
func _initialize() -> void: call_deferred("run")
func check(ok: bool, label: String) -> void:
	if not ok: failures+=1; push_error("TEST FAILED: "+label)
	else: print("PASS ",label)
func move_history(model: RefCounted, index: int) -> void:
	model.start(index,"history%d"%index)
	model.drag(index,Vector2(10,0))
	model.release(index)
func pull(model: RefCounted, book: int, pixels: float, visible: bool=true, id: int=7) -> bool:
	model.start(id,"book:%d"%book)
	model.drag(id,Vector2(0,pixels))
	return model.release(id,visible)
func run() -> void:
	var model := Model.new()
	check(model.start(0,"history0") and model.start(1,"history1"),"two historical windows have independent owners")
	check(not model.start(0,"book:0") and not model.start(2,"history0"),"duplicate pointer and duplicate object are rejected")
	model.release(2)
	check(model.input.owners.size()==2,"rejected finger release cannot release either owner")
	model.reset()
	check(not model.start(0,"unknown") and not model.start(0,"book:6") and not model.start(0,"book:4extra"),"only exact known objects can be selected")
	check(not model.start(-3,"history0"),"unknown negative input identities cannot acquire ownership")
	check(model.start(0,"book:0") and not model.start(1,"book:1"),"only one current book may be pulled at a time")
	model.reset()
	# History visibility belongs to presentation, not to the retrieval API.
	# Hidden histories therefore submit exactly the same valid current-book action.
	var has_history_credential := model.has_method("observe")
	for property: Dictionary in model.get_property_list():
		if property.name in ["moved","travel","observed","dwell"]: has_history_credential=true
	check(not has_history_credential,"model stores no movement, dwell or observation credentials")
	for moved_windows: int in range(3):
		model.reset()
		for index: int in range(moved_windows): move_history(model,index)
		check(not model.completed,"moving %d history windows cannot retrieve a book"%moved_windows)
		check(pull(model,Model.TARGET_BOOK,54),"valid visible pull succeeds after %d history-window moves"%moved_windows)
	model.reset()
	check(pull(model,Model.TARGET_BOOK,54),"hidden or untouched histories cannot block the same valid visible current-book pull")
	model.reset()
	model.start(7,"book:4")
	check(not model.release(7) and not model.completed,"grabbing and releasing without a pull cannot complete")
	check(not pull(model,Model.TARGET_BOOK,53.9),"short pull does not take a book")
	check(not pull(model,3,72) and model.selected_book==-1 and model.pull==0,"wrong book is rejected and returned without consumption")
	check(not pull(model,Model.TARGET_BOOK,72,false),"hidden present book cannot be accepted on release")
	check(pull(model,Model.TARGET_BOOK,54),"correct visible 54-pixel pull completes without a history prerequisite")
	check(model.completion_count==1 and model.input.owners.is_empty(),"completion is emitted once and clears ownership")
	check(not model.start(8,"book:4") and not model.release(7),"completed retrieval and stale release cannot duplicate completion")
	model.reset()
	check(model.start(Model.KEYBOARD_OWNER,"history0") and model.start(0,"history1"),"keyboard and touch can own different windows")
	check(not model.start(Model.KEYBOARD_OWNER,"book:4") and not model.start(1,"history0"),"keyboard obeys one target per owner and excludes competing touch")
	model.cancel(Model.KEYBOARD_OWNER)
	check(model.input.owners.size()==1 and model.input.owners.get(0)=="history1","canceling keyboard history preserves the touch owner")
	check(not model.start(Model.KEYBOARD_OWNER,"history1"),"keyboard cannot steal an existing touch target")
	model.cancel(99)
	check(model.input.owners.get(0)=="history1","canceling an unknown owner leaves active touch intact")
	check(model.start(Model.KEYBOARD_OWNER,"book:4"),"keyboard can grab a current book while another hand holds history")
	model.drag(Model.KEYBOARD_OWNER,Vector2(0,72))
	model.cancel(Model.KEYBOARD_OWNER)
	check(model.selected_book==-1 and model.pull==0 and not model.completed and model.rejected_count==0,"keyboard cancellation returns its pulled book without accepting or rejecting it")
	check(model.input.owners.get(0)=="history1" and not model.release(Model.KEYBOARD_OWNER),"keyboard cancellation does not drop touch or leave a releasable stale grab")
	model.reset()
	model.start(0,"book:4"); model.drag(0,Vector2(0,30)); model.start(Model.KEYBOARD_OWNER,"history0")
	model.cancel(Model.KEYBOARD_OWNER)
	check(model.selected_book==4 and is_equal_approx(model.pull,30.0/72.0) and model.input.owners.get(0)=="book:4","canceling keyboard history does not reset a simultaneous touch pull")
	model.cancel(0)
	check(model.selected_book==-1 and model.pull==0 and not model.completed,"canceling the actual book owner returns that book")
	model.reset()
	check(pull(model,Model.TARGET_BOOK,54,true,Model.KEYBOARD_OWNER),"keyboard retrieval uses the same target, visibility and pull threshold")
	model.reset()
	check(pull(model,Model.TARGET_BOOK,54,true,-1),"mouse retrieval uses the same target, visibility and pull threshold")
	model.reset()
	model.start(5,"book:4"); model.drag(5,Vector2(NAN,72)); model.drag(5,Vector2(0,INF))
	check(model.pull==0,"non-finite drag cannot create a pull")
	model.drag(5,Vector2(0,72)); model.suspend()
	check(model.suspended and model.input.owners.is_empty() and model.selected_book==-1 and model.pull==0,"suspend drops book selection and every input owner")
	check(not model.completed and not model.release(5) and not model.start(Model.KEYBOARD_OWNER,"book:4"),"suspension blocks stale release and new keyboard grabs")
	model.resume()
	check(not model.suspended and model.input.owners.is_empty() and model.selected_book==-1,"explicit resume does not restore stale input")
	model.reset()
	check(model.rejected_count==0 and model.completion_count==0 and not model.completed,"reset restores only local retrieval state")
	print("LIBRARY_MODEL failures=",failures)
	quit(1 if failures else 0)
