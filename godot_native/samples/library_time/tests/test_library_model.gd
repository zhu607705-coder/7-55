extends SceneTree
const Model = preload("res://scripts/library_model.gd")
var failures := 0
func _initialize() -> void: call_deferred("run")
func check(ok: bool, label: String) -> void:
	if not ok: failures += 1; push_error("TEST FAILED: " + label)
	else: print("PASS ", label)
func move_history(model: RefCounted, index: int) -> void:
	model.start(index, "history%d" % index)
	model.drag(index, Vector2(10, 0))
	model.release(index)
func observe(model: RefCounted, visibility: Array) -> void:
	for i: int in range(24): model.observe(1.0 / 30.0, visibility)
func pull(model: RefCounted, book: int, pixels: float, visible: bool = true) -> bool:
	model.start(7, "book:%d" % book)
	model.drag(7, Vector2(0, pixels))
	return model.release(7, visible)
func run() -> void:
	var model := Model.new()
	check(model.start(0, "history0") and model.start(1, "history1"), "two historical windows have independent owners")
	check(not model.start(0, "book:0") and not model.start(2, "history0"), "duplicate pointer and duplicate object are rejected")
	model.release(2)
	check(model.input.owners.size() == 2, "rejected finger release cannot release either owner")
	model.reset()
	var slow := Model.new()
	var single := Model.new()
	slow.start(0, "history0"); single.start(0, "history0")
	for i: int in range(100): slow.drag(0, Vector2(0.1, 0))
	single.drag(0, Vector2(10, 0))
	check(slow.moved[0] and single.moved[0], "slow 0.1-pixel samples and one 10-pixel drag both move history")
	observe(slow, [true, false]); observe(single, [true, false])
	check(slow.observed == single.observed and slow.observed[0], "historical observation is independent of input event granularity")
	slow.reset(); slow.start(0, "history0"); slow.drag(0, Vector2(1, 0))
	check(not slow.moved[0], "reset clears accumulated movement instead of retaining old gesture distance")
	check(not model.start(0, "unknown") and not model.start(0, "book:6"), "unknown object and out-of-range book are rejected")
	check(model.start(0, "book:0") and not model.start(1, "book:1"), "only one current book may be pulled at a time")
	model.reset()
	observe(model, [true, true])
	check(not model.observed[0] and not model.observed[1] and not model.completed, "idle visible windows cannot grant observation or completion")
	check(not pull(model, Model.TARGET_BOOK, 72), "correct guess before observation cannot complete")
	move_history(model, 0); move_history(model, 1)
	observe(model, [false, false])
	check(not model.observed[0] and not model.observed[1], "moved but hidden windows cannot grant evidence")
	observe(model, [true, false])
	check(model.observed[0] and not model.observed[1], "visible upper fragment does not imply lower fragment")
	check(not pull(model, Model.TARGET_BOOK, 72), "one historical fragment is not enough")
	observe(model, [true, true])
	check(model.observed[0] and model.observed[1] and not model.completed, "two observed fragments still require present-book interaction")
	check(not pull(model, 3, 72) and model.selected_book == -1 and model.pull == 0, "wrong book is rejected and returned without consumption")
	check(not pull(model, Model.TARGET_BOOK, 53.9), "short pull does not take a book")
	check(not pull(model, Model.TARGET_BOOK, 72, false), "hidden present book cannot be accepted on release")
	check(pull(model, Model.TARGET_BOOK, 54), "two observations and a visible 54-pixel pull complete retrieval")
	check(model.completion_count == 1 and model.input.owners.is_empty(), "completion is emitted once and clears ownership")
	check(not model.start(8, "book:4"), "completed retrieval cannot be submitted again")
	observe(model, [true, true])
	check(model.completion_count == 1, "continued observation cannot duplicate completion")
	model.reset(); move_history(model, 0)
	for i: int in range(10): model.observe(1.0 / 30.0, [true, true])
	model.observe(2.0, [true, true])
	check(model.dwell == [0.0, 0.0] and not model.observed[0], "long background frame cannot count as continuous observation")
	model.start(5, "book:4"); model.drag(5, Vector2(0, 72)); model.suspend()
	check(model.suspended and model.input.owners.is_empty() and model.selected_book == -1 and model.pull == 0, "suspend drops both book selection and pointer ownership")
	observe(model, [true, true])
	check(not model.completed and not model.release(5), "suspended observation and stale release cannot complete")
	model.resume()
	check(not model.suspended and model.input.owners.is_empty() and model.dwell == [0.0, 0.0], "explicit resume does not restore stale input or partial dwell")
	model.reset()
	check(model.observed == [false, false] and model.moved == [false, false] and model.rejected_count == 0 and model.completion_count == 0, "reset restores a clean local puzzle without formal state")
	print("LIBRARY_MODEL failures=", failures)
	quit(1 if failures else 0)
