extends SceneTree
const SCENE=preload("res://scenes/raking_light.tscn")
var checks:=0
var failures:=0
var view: Control

func _initialize() -> void: call_deferred("run")
func check(ok: bool, label: String) -> void:
	checks+=1
	if not ok: failures+=1; push_error("TEST FAILED: "+label)
	else: print("PASS ",label)
func frames(n: int=2) -> void:
	for i: int in range(n): await process_frame
func touch(id: int,p: Vector2,down: bool,canceled: bool=false) -> void:
	var e:=InputEventScreenTouch.new(); e.index=id; e.position=p; e.pressed=down; e.canceled=canceled
	Input.parse_input_event(e); await frames()
func drag(id: int,from: Vector2,to: Vector2) -> void:
	var e:=InputEventScreenDrag.new(); e.index=id; e.position=to; e.relative=to-from
	Input.parse_input_event(e); await frames()
func mouse(p: Vector2,down: bool,device: int=0) -> void:
	var e:=InputEventMouseButton.new(); e.device=device; e.position=p; e.global_position=p; e.button_index=MOUSE_BUTTON_LEFT; e.pressed=down
	Input.parse_input_event(e); await frames()
func mouse_move(from: Vector2,to: Vector2,device: int=0) -> void:
	var e:=InputEventMouseMotion.new(); e.device=device; e.position=to; e.global_position=to; e.relative=to-from; e.button_mask=MOUSE_BUTTON_MASK_LEFT
	Input.parse_input_event(e); await frames()
func arrangement() -> Array: return [view.model.paper_tilt,view.model.lamp_azimuth,view.model.lamp_elevation]
func reset() -> void:
	view.model.reset(); view.pointer_positions.clear(); view.history_offset=Vector2.ZERO; view._layout(); view._process(0); await frames()
func run() -> void:
	root.size=Vector2i(390,844)
	view=SCENE.instantiate(); root.add_child(view); await frames(4); view.set_process(false)
	await reset()
	var paper: Vector2=view.paper_hit_point(); var lamp: Vector2=view.lamp_hit_point()
	check(view._target(paper)=="paper" and view._target(lamp)=="lamp","Visible paper tab and lamp shade are their own input targets")
	await touch(0,paper,true); await touch(1,lamp,true)
	check(view.model.owners.get(0)=="paper" and view.model.owners.get(1)=="lamp","Ordinary dual touch acquires two real objects independently")
	await touch(2,paper,true)
	check(not view.model.owners.has(2) and view.model.owners.get(0)=="paper","Second paper finger cannot steal the first owner's object")
	var end_paper: Vector2=paper+Vector2(-38,-56)
	await drag(0,paper,end_paper)
	check(view.model.paper_tilt.distance_to(Vector2(8.96,-6.08))<0.01 and is_equal_approx(view.model.lamp_elevation,80),"Paper gesture changes only its real tilt")
	var end_lamp: Vector2=lamp+Vector2(-140,128)
	await drag(1,lamp,end_lamp)
	check(view.model.owners.size()==2 and is_equal_approx(view.model.lamp_azimuth,-28) and is_equal_approx(view.model.lamp_elevation,16.0),"Lamp gesture is reachable while the paper finger remains held")
	view._process(0)
	print("RAKING_PLANNED_GESTURE metrics=",view.metrics," angles=",arrangement())
	check(view.metrics.contrast>=0.13 and view.metrics.coverage>=0.72 and view.metrics.incidence>=3 and view.metrics.incidence<=24,"Planned ordinary gesture reaches real valid groove visibility")
	await touch(2,end_lamp,false)
	check(view.model.owners.size()==2,"Release from a rejected third finger cannot release either real owner")
	await touch(1,end_lamp,false)
	check(view.model.owners.has(0) and not view.model.owners.has(1),"Releasing lamp retains the paper owner's grip")
	await touch(0,end_paper,false)
	for i: int in range(60): view._process(1.0/30.0)
	check(view.model.completed and view.model.completion_count==1,"Stable observation after real touch manipulation completes once")
	for i: int in range(40): view._process(1.0/30.0)
	check(view.current_world.door_hinge.rotation.y<deg_to_rad(-70),"Local completion visibly opens the physical preview door")
	await reset(); paper=view.paper_hit_point(); lamp=view.lamp_hit_point()
	await touch(0,paper,true); await touch(1,lamp,true)
	var before: Array=arrangement()
	view.notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	await touch(0,paper,false); await touch(1,lamp,false)
	check(view.model.suspended and view.model.owners.is_empty() and view.pointer_positions.is_empty() and arrangement()==before,"Backgrounding clears both pointers without changing the physical arrangement")
	for i: int in range(90): view._process(1.0/30.0)
	check(not view.model.completed and view.model.stable_time==0,"Suspended background time cannot complete observation")
	view.resume.pressed.emit(); view._process(0)
	check(not view.model.suspended and view.model.owners.is_empty(),"Explicit continue cannot resurrect old pointers")
	await touch(0,paper,true); await touch(1,lamp,true)
	root.size=Vector2i(844,390); await frames(5)
	check(view.model.suspended and view.model.owners.is_empty() and view.pointer_positions.is_empty(),"Rotation cancels stale gesture geometry and suspends observation")
	root.size=Vector2i(390,844); await frames(4); await reset()
	paper=view.paper_hit_point(); lamp=view.lamp_hit_point()
	await touch(0,paper,true)
	await mouse(lamp,true,-1)
	check(not view.model.owners.has(-1) and view.model.owners.get(0)=="paper","Emulated mouse press cannot acquire a second object alongside real touch")
	await mouse(lamp,false,-1); await touch(0,paper,false)
	await reset(); before=arrangement()
	var history: Vector2=view.history_rect.get_center()
	var old_light: Transform3D=view.current_world.lamp.global_transform
	var old_metrics: Dictionary=view.metrics.duplicate(true)
	await touch(0,history,true); await drag(0,history,history+Vector2(0,60)); await touch(0,history+Vector2(0,60),false)
	view._process(0)
	check(arrangement()==before and view.current_world.lamp.global_transform==old_light and view.metrics==old_metrics,"Dragging the recorded view does not change current paper, lamp or visibility")
	# Cover the real paper with history: the visible top layer must own the press.
	paper=view.paper_hit_point(); view.history_rect.position=paper-view.history_rect.size*0.5; view._clamp_history()
	before=arrangement()
	await touch(0,paper,true); await drag(0,paper,paper+Vector2(10,0)); await touch(0,paper+Vector2(10,0),false)
	check(arrangement()==before,"History overlay cannot click through to the current paper")
	await reset(); paper=view.paper_hit_point(); lamp=view.lamp_hit_point()
	await mouse(paper,true); await mouse_move(paper,paper+Vector2(-38,-56)); await mouse(paper+Vector2(-38,-56),false)
	view._process(0); lamp=view.lamp_hit_point()
	await mouse(lamp,true); await mouse_move(lamp,lamp+Vector2(-140,128)); await mouse(lamp+Vector2(-140,128),false)
	for i: int in range(60): view._process(1.0/30.0)
	check(view.model.completed and view.model.completion_count==1,"Sequential mouse dragging preserves both adjustments and can complete without two mice")
	# Repeat real adjustment, then hide the clue using an ordinary history drag.
	await reset(); paper=view.paper_hit_point(); lamp=view.lamp_hit_point()
	await touch(0,paper,true); await drag(0,paper,paper+Vector2(-38,-56)); await touch(0,paper+Vector2(-38,-56),false)
	view._process(0); lamp=view.lamp_hit_point()
	await touch(1,lamp,true); await drag(1,lamp,lamp+Vector2(-140,128)); await touch(1,lamp+Vector2(-140,128),false)
	view._process(0)
	var history_home: Vector2=view.history_rect.get_center()
	var clue_center: Vector2=view.current_rect.position+view.current_world.screen_point(view.current_world.paper_pivot.global_position)
	before=arrangement()
	await touch(2,history_home,true); await drag(2,history_home,clue_center); await touch(2,clue_center,false)
	for i: int in range(75): view._process(1.0/30.0)
	check(view.metrics.world_coverage>=0.72 and view.metrics.screen_coverage==0 and view.metrics.coverage==0,"History overlay hides every groove sample without changing the real lamp coverage")
	check(not view.model.completed and view.model.stable_time==0 and arrangement()==before,"A fully obscured clue cannot finish stable observation or alter its physical arrangement")
	var covered_center: Vector2=view.history_rect.get_center()
	await touch(2,covered_center,true); await drag(2,covered_center,history_home); await touch(2,history_home,false)
	for i: int in range(24): view._process(1.0/30.0)
	check(not view.model.completed and view.metrics.screen_coverage>=0.72,"Moving history away restores visibility but does not reuse hidden observation time")
	for i: int in range(36): view._process(1.0/30.0)
	check(view.model.completed and view.model.completion_count==1,"Uncovering the real clue allows a new stable observation to complete")
	await reset(); paper=view.paper_hit_point(); lamp=view.lamp_hit_point()
	await touch(0,paper,true); await touch(1,lamp,true)
	await drag(0,paper,Vector2(-15,paper.y))
	check(view.model.suspended and view.model.owners.is_empty() and view.pointer_positions.is_empty(),"Leaving the screen suspends safely and releases both objects")
	await touch(0,paper,false); await touch(1,lamp,false)
	check(view.model.suspended and not view.model.completed,"Stale releases after an out-of-bounds drag cannot resume or complete")
	await reset(); paper=view.paper_hit_point(); lamp=view.lamp_hit_point()
	await touch(0,paper,true); await touch(1,lamp,true); await touch(0,paper,false,true)
	check(view.model.suspended and view.model.owners.is_empty() and not view.model.completed,"OS touch cancellation cannot submit partial observation")
	view.retry.pressed.emit(); view._process(0)
	check(not view.model.suspended and not view.model.completed and view.model.completion_count==0 and view.pointer_positions.is_empty(),"Visible retry clears all gesture and completion state")
	check(view.find_children("*","Label",true,false).is_empty() and not view.retry.visible and not view.resume.visible,"Ordinary main view has no text panel or exposed retry/continue controls")
	var menu_point: Vector2=view.menu_button.get_global_rect().get_center()
	await touch(0,menu_point,true); await touch(0,menu_point,false)
	check(view.model.suspended and view.resume.visible and view.retry.visible,"Ordinary touchscreen tap opens the secondary pause menu")
	var resume_point: Vector2=view.resume.get_global_rect().get_center()
	await touch(0,resume_point,true); await touch(0,resume_point,false)
	check(not view.model.suspended and not view.resume.visible,"Ordinary touchscreen tap resumes from the secondary menu")
	await reset()
	menu_point=view.menu_button.get_global_rect().get_center()
	view.history_rect.position=menu_point-view.history_rect.size*0.5; view._clamp_history(); view.history_image.position=view.history_rect.position
	await mouse(menu_point,true); await mouse(menu_point,false)
	check(view.model.suspended,"Topmost secondary menu remains operable when the history window is dragged underneath it")
	view.resume.pressed.emit()
	for size_value: Vector2i in [Vector2i(320,568),Vector2i(844,390),Vector2i(1100,760)]:
		root.size=size_value; await frames(5); await reset()
		paper=view.paper_hit_point(); lamp=view.lamp_hit_point()
		check(view._target(paper)=="paper" and view._target(lamp)=="lamp","Paper and lamp targets remain reachable at "+str(size_value))
	print("RAKING_INPUT checks=",checks," failures=",failures," real_input_events=true rendered_pixels=false")
	view.queue_free(); await frames(); quit(1 if failures else 0)
