; Isolated presentation study. No story autoloads, saves, or external resources.
config_version=5

[application]
config/name="7:55 · Phone to campus · POC"
run/main_scene="res://transition.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="SevenFiftyFivePhoneCampusPreview"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
; Use actual logical window size. A fixed 1280-wide canvas would shrink touch targets.
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.83, 0.83, 0.77, 1)
