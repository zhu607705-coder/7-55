; Independent, opt-in research viewer. No story autoloads or save writes.
config_version=5

[application]
config/name="7:55 · 北教真实资料预览"
config/description="Historical plan registry and approximate first-floor artwork. Not a playable reconstruction."
run/main_scene="res://preview.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="SevenFiftyFiveNorthPlanPreview"

[display]
window/size/viewport_width=1280
window/size/viewport_height=820
window/size/window_width_override=1280
window/size/window_height_override=820
window/size/min_width=360
window/size/min_height=540

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.055, 0.07, 0.09, 1)
