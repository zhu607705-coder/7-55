config_version=5

[application]
config/name="7:55 · 一页未落定 · 独立机制样例"
config/description="Independent paper-only rewind experiment. No story state or save access."
run/main_scene="res://scenes/paper_rewind.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=760
window/size/window_width_override=1100
window/size/window_height_override=760
window/stretch/mode="disabled"

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.09, 0.12, 0.15, 1)

